# Source builds and staged player folders use the same launcher/engine contract.
if(NOT EXISTS "${PT5_ENGINE}")
    message(FATAL_ERROR "Build the GT5 engine before staging its player files")
endif()
file(SHA256 "${PT5_ENGINE}" engine_hash)
if(NOT PT5_TARGET)
    set(PT5_TARGET "BCUS98114-v104")
endif()
# Preserve the other engine's declaration when both are staged into one folder.
set(release "${PT5_DEST}/pt5-release.ini")
if(PT5_TARGET STREQUAL "BCUS98114-v104")
    file(WRITE "${PT5_DEST}/pt5-release-v104.ini" "[BCUS98114-v104]\nengine_sha256=${engine_hash}\nvolmap=1\n")
else()
    file(WRITE "${PT5_DEST}/pt5-release-v211.ini" "[BCUS98114-v211]\nengine_sha256=${engine_hash}\nvolmap=1\nexperimental=1\n")
endif()
set(content "[game]\ntarget=${PT5_TARGET}\nengine_sha256=${engine_hash}\nvolmap=1\n")
foreach(name v104 v211)
    if(EXISTS "${PT5_DEST}/pt5-release-${name}.ini")
        file(READ "${PT5_DEST}/pt5-release-${name}.ini" section)
        string(APPEND content "\n${section}")
    endif()
endforeach()
file(WRITE "${release}" "${content}")
file(MAKE_DIRECTORY "${PT5_DEST}/assets")
file(COPY "${PT5_SOURCE}/assets/glyphs" DESTINATION "${PT5_DEST}/assets")
foreach(name "START-HERE.txt" "Change storage.cmd" "Change game files.cmd" "Open storage.cmd" "recomplauncher.json")
    configure_file("${PT5_SOURCE}/launcher/${name}" "${PT5_DEST}/${name}" COPYONLY)
endforeach()
