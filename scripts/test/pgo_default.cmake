# cmake -P scripts/test/pgo_default.cmake
# Selection checks use synthetic bytes, never a game-derived profile.
get_filename_component(repo "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(module "${repo}/cmake/LocalPGO.cmake")
set(CMAKE_SOURCE_DIR "${repo}/scratch/pgo-default-test")
file(MAKE_DIRECTORY "${CMAKE_SOURCE_DIR}/scratch/pgo")
set(GT5P_TARGET "BCUS98114-v104")
set(GT5P_PGO_AUTO ON CACHE BOOL "" FORCE)
file(REMOVE "${CMAKE_SOURCE_DIR}/scratch/pgo/gt5.profdata")
include("${module}")
if(CMAKE_C_COMPILER_LAUNCHER OR CMAKE_CXX_COMPILER_LAUNCHER)
    message(FATAL_ERROR "Missing profile must leave compilers unprofiled")
endif()
file(WRITE "${CMAKE_SOURCE_DIR}/scratch/pgo/gt5.profdata" "synthetic selection fixture")
set(GT5P_PGO_AUTO OFF CACHE BOOL "" FORCE)
include("${module}")
if(CMAKE_C_COMPILER_LAUNCHER OR CMAKE_CXX_COMPILER_LAUNCHER)
    message(FATAL_ERROR "Rollback must leave compilers unprofiled")
endif()
set(GT5P_PGO_AUTO ON CACHE BOOL "" FORCE)
set(GT5P_TARGET "BCUS98114-v211")
include("${module}")
if(CMAKE_C_COMPILER_LAUNCHER OR CMAKE_CXX_COMPILER_LAUNCHER)
    message(FATAL_ERROR "01.04 profile must not be used for 2.11")
endif()
set(GT5P_TARGET "BCUS98114-v104")
set(CMAKE_C_COMPILER_LAUNCHER "explicit-instrumentation")
include("${module}")
if(NOT CMAKE_C_COMPILER_LAUNCHER STREQUAL "explicit-instrumentation" OR CMAKE_CXX_COMPILER_LAUNCHER)
    message(FATAL_ERROR "Explicit launchers must take precedence")
endif()
unset(CMAKE_C_COMPILER_LAUNCHER)
include("${module}")
if(NOT CMAKE_C_COMPILER_LAUNCHER MATCHES "pgocc.py;use;.*gt5-[a-f0-9]+.profdata$"
   OR NOT CMAKE_C_COMPILER_LAUNCHER STREQUAL CMAKE_CXX_COMPILER_LAUNCHER)
    message(FATAL_ERROR "Available profile must select both compiler launchers")
endif()
set(old_launcher "${CMAKE_C_COMPILER_LAUNCHER}")
unset(CMAKE_C_COMPILER_LAUNCHER)
unset(CMAKE_CXX_COMPILER_LAUNCHER)
file(APPEND "${CMAKE_SOURCE_DIR}/scratch/pgo/gt5.profdata" " changed")
include("${module}")
if(CMAKE_C_COMPILER_LAUNCHER STREQUAL old_launcher)
    message(FATAL_ERROR "Changed profile must change the compile command")
endif()
message(STATUS "Default PGO selection, rollback, target isolation and profile refresh PASS")
