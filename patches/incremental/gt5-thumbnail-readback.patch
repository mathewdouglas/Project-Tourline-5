+/* Large readbacks (RSX_BLIT_READBACK_LARGE, default on): 1:1 blits of a
+ * GPU-only surface bigger than the 64x64 slots above. Gran Turismo 5 2.11
+ * renders each garage thumbnail into a local surface and blits it (192x54
+ * and 384x108, A8R8G8B8) into main memory, where the PPU encodes the PNG; the
+ * blit copied stale bytes, so every car's picture was the same noise. Each
+ * gets its own readback buffer, copied at its place in the frame, and is
+ * written into the blit's destination and the source surface's guest memory
+ * when the next frame starts (after the blit's own stale copy). Note runs on
+ * the recording thread; replay and flush on the replay thread. */
+static void render_frame(void);
+static void rt_wait_idle(void);
+static void lrb_flush(void);
+static HANDLE s_rt_thr;
+#define LRB_MAX 8
+#define LRB_MAX_SIDE 2048u
+static struct {
+    ID3D12Resource* buf; u64 cap;
+    u32 w, h, ea, pitch, dst_ea, dst_pitch, gx, gy, hx, hy, bpp, row;
+    float kx, ky;
+} s_lrb[LRB_MAX];
+static int s_lrb_n;
+
+static int lrb_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("RSX_BLIT_READBACK_LARGE"); on = !(e && e[0] == '0'); }
+    return on && blit_rb_on();
+}
+
+void rsx_d3d12_note_blit_copy(u32 off, u32 pitch, u32 w, u32 h, u32 dst_ea, u32 dst_pitch)
+{
+    extern u32 cellGcmResolveLocated(int local, u32 offset);
+    if (!lrb_on() || !w || !h || w > LRB_MAX_SIDE || h > LRB_MAX_SIDE || !pitch || (pitch & 3u) ||
+        !dst_ea || dst_pitch < w * 4u)
+        return;
+    if (FR->draw_count >= s_draw_cap) return;
+    /* The surface the last large blit read: a frame cut by the sync below
+     * leaves no draw into it for the blits right after (GT5 reads each
+     * thumbnail as two halves, one blit each). */
+    static D3D12DrawRecord s_lrb_last;
+    static int s_lrb_last_ok;
+    for (int d = (int)FR->draw_count - 1; d >= -1; d--) {
+        const D3D12DrawRecord* sd = d >= 0 ? &FR->draws[d] : (s_lrb_last_ok ? &s_lrb_last : NULL);
+        if (!sd) break;
+        if (sd->is_clear || !sd->is_vp || !sd->rt_off || sd->rt_pitch != pitch) continue;
+        if (off < sd->rt_off || off - sd->rt_off >= pitch * (sd->rt_h ? sd->rt_h : 1u)) continue;
+        if (d >= 0) { s_lrb_last = *sd; s_lrb_last_ok = 1; }
+        const u32 dlt = off - sd->rt_off, x = (dlt % pitch) / 4u, y = dlt / pitch;
+        D3D12DrawRecord* dr = &FR->draws[FR->draw_count++];
+        memset(dr, 0, sizeof(*dr));
+        dr->is_vp = 1; dr->is_clear = 1; dr->readback = 1; dr->rb_large = 1; dr->tex_slot = -1;
+        dr->rt_off = sd->rt_off; dr->rt_pitch = pitch; dr->rt_w = sd->rt_w; dr->rt_h = sd->rt_h;
+        dr->rb_x = (u16)x; dr->rb_y = (u16)y; dr->rb_w = (u16)w; dr->rb_h = (u16)h;
+        dr->rb_ea = cellGcmResolveLocated(1, off);
+        dr->rb_dst_ea = dst_ea; dr->rb_dst_pitch = dst_pitch;
+        /* RSX_BLIT_READBACK_SRC=1 (diagnostic, with _DUMP): also read back what the
+         * source draw's unit 0 sampled, when that is a target (written over its
+         * own guest memory). */
+        { static int srcdbg = -1;
+          if (srcdbg < 0) { const char* e = getenv("RSX_BLIT_READBACK_SRC"); srcdbg = e ? atoi(e) : 0; }
+          const D3D12DrawRecord* sd0 = sd; int from = d;
+          if (d < 0) srcdbg = srcdbg > 0 ? srcdbg : 0, from = -1;
+          for (int lvl = 0; lvl < srcdbg; lvl++) {
+          const u32 traw = sd->tex[0].raw, tw = sd->tex[0].w, th = sd->tex[0].h;
+          if (sd->tex[0].set && sd->tex[0].local && tw && th && tw <= LRB_MAX_SIDE && th <= LRB_MAX_SIDE &&
+              FR->draw_count < s_draw_cap) {
+              int ts = -1;
+              for (int q = from; q >= 0 && ts < 0; q--)
+                  if (FR->draws[q].rt_off == traw && FR->draws[q].is_vp && !FR->draws[q].is_clear) ts = q;
+              if (ts >= 0) {
+                  const D3D12DrawRecord* td = &FR->draws[ts];
+                  D3D12DrawRecord* x2 = &FR->draws[FR->draw_count++];
+                  memset(x2, 0, sizeof(*x2));
+                  x2->is_vp = 1; x2->is_clear = 1; x2->readback = 1; x2->rb_large = 1; x2->tex_slot = -1;
+                  x2->rt_off = traw; x2->rt_pitch = td->rt_pitch; x2->rt_w = td->rt_w; x2->rt_h = td->rt_h;
+                  x2->rb_x = 0; x2->rb_y = 0; x2->rb_w = (u16)tw; x2->rb_h = (u16)th;
+                  x2->rb_ea = cellGcmResolveLocated(1, traw);
+                  x2->rb_dst_ea = x2->rb_ea; x2->rb_dst_pitch = td->rt_pitch;
+                  fprintf(stderr, "[blit-rb] src readback %d: draw %d into 0x%X (rt %ux%u fp 0x%08X) %ux%u%c",
+                          lvl, ts, traw, td->rt_w, td->rt_h, td->fp_addr, tw, th, 10);
+                  sd = td; from = ts - 1;
+              } else { fprintf(stderr, "[blit-rb] src readback %d: no draw this frame into 0x%X%c", lvl, traw, 10); break; }
+          } else break;
+          }
+          sd = sd0; }
+        { static int _n; if (getenv("RSX_BLIT_READBACK_DBG") && (_n < 24 && ++_n))
+            fprintf(stderr, "[blit-rb] large note: source draw %d (rt %ux%u) rect %u,%u %ux%u -> 0x%08X/%u%c",
+                    d, sd->rt_w, sd->rt_h, x, y, w, h, dst_ea, dst_pitch, 10);
+          /* RSX_BLIT_READBACK_DBG=2: the draws into this surface before it. */
+          { const char* dbg2 = getenv("RSX_BLIT_READBACK_DBG"); if (dbg2 && dbg2[0] == '2')
+              for (int q = d, shown = 0; q >= 0 && shown < 12; q--) {
+                  const D3D12DrawRecord* p = &FR->draws[q];
+                  if (p->rt_off != sd->rt_off) continue;
+                  shown++;
+                  fprintf(stderr, "[blit-rb]   draw %d clear=%d fp 0x%08X vp %u,%u %ux%u n %u t0 raw 0x%08X %ux%u fmt 0x%X loc %d rt %d | t1 raw 0x%08X rt %d%c",
+                          q, p->is_clear, p->fp_addr, p->vp_x, p->vp_y, p->vp_w, p->vp_h, p->vertex_count,
+                          p->tex[0].raw, p->tex[0].w, p->tex[0].h, p->tex[0].fmt, p->tex[0].local, p->tex_rt[0],
+                          p->tex[1].raw, p->tex_rt[1], 10);
+              } } }
+        /* The guest reads the destination as soon as the GPU passes a label
+         * after the blit, which this walker writes long before the next frame
+         * starts: replay what is recorded now (an offscreen batch, no present),
+         * wait for it and write the pixels before going on; the flush writes the
+         * source surface too, so the blit's own copy below carries them.
+         * RSX_BLIT_READBACK_SYNC=0: at the next frame's start, as before. */
+        { static int sync = -1;
+          if (sync < 0) { const char* e = getenv("RSX_BLIT_READBACK_SYNC"); sync = !(e && e[0] == '0'); }
+          if (sync && s_d3d.initialized && !s_device_lost) {
+              FR->present = 0;
+              render_frame();
+              FR->present = 1;
+              if (s_rt_thr) rt_wait_idle();
+              wait_for_gpu();
+              lrb_flush();
+          } }
+        return;
+    }
+    { static int _n; if (getenv("RSX_BLIT_READBACK_DBG") && (_n < 24 && ++_n))
+        fprintf(stderr, "[blit-rb] large: no draw this frame into 0x%X (pitch %u)%c", off, pitch, 10); }
+}
+
+static void lrb_replay(const D3D12DrawRecord* dr, int cur_rt)
+{
+    /* Several targets can share an offset at different sizes: take the one of
+     * the guest size the source draws had, then the bound one, then any. */
+    int slot = -1;
+    for (int i = 0; i < MAX_OFF_RTS && slot < 0; i++)
+        if (s_d3d.off_rt[i].res && s_d3d.off_rt[i].off == dr->rt_off &&
+            rt_gw(i) == dr->rt_w && rt_gh(i) == dr->rt_h) slot = i;
+    if (slot < 0) slot = (cur_rt >= 0 && s_d3d.off_rt[cur_rt].off == dr->rt_off) ? cur_rt : off_rt_find(dr->rt_off);
+    { static int _n; if (getenv("RSX_BLIT_READBACK_DBG") && (_n < 24 && ++_n))
+        fprintf(stderr, "[blit-rb] large replay: slot %d (%ux%u, guest %ux%u) for guest %ux%u, cur_rt %d, first match %d%c",
+                slot, slot >= 0 ? s_d3d.off_rt[slot].w : 0, slot >= 0 ? s_d3d.off_rt[slot].h : 0,
+                slot >= 0 ? rt_gw(slot) : 0, slot >= 0 ? rt_gh(slot) : 0, dr->rt_w, dr->rt_h, cur_rt,
+                off_rt_find(dr->rt_off), 10); }
+    if (slot < 0 || s_lrb_n >= LRB_MAX) return;
+    OffRT* r = &s_d3d.off_rt[slot];
+    const u32 rbpp = r->dxgi == (u32)DXGI_FORMAT_R16G16B16A16_UNORM ? 8u : 4u;
+    if (!dxgi_is_rgba8_class(r->dxgi)) return;
+    const u32 gwid = rt_gw(slot), ghei = rt_gh(slot);
+    const float kx = gwid ? (float)r->w / (float)gwid : 1.0f;
+    const float ky = ghei ? (float)r->h / (float)ghei : 1.0f;
+    const u32 hx = (u32)(dr->rb_x * kx), hw = (u32)ceilf((dr->rb_x + dr->rb_w) * kx) - hx;
+    const u32 hy = (u32)(dr->rb_y * ky), hh = (u32)ceilf((dr->rb_y + dr->rb_h) * ky) - hy;
+    if (!hw || !hh || hx + hw > r->w || hy + hh > r->h) return;
+    const u32 row = (hw * rbpp + 255u) & ~255u;
+    const u64 need = (u64)row * hh;
+    const int k = s_lrb_n;
+    if (!s_lrb[k].buf || s_lrb[k].cap < need) {
+        if (s_lrb[k].buf) { s_lrb[k].buf->lpVtbl->Release(s_lrb[k].buf); s_lrb[k].buf = NULL; }
+        D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_READBACK;
+        D3D12_RESOURCE_DESC rd = {0};
+        rd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+        rd.Width = need; rd.Height = 1; rd.DepthOrArraySize = 1;
+        rd.MipLevels = 1; rd.SampleDesc.Count = 1; rd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE,
+                &rd, D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&s_lrb[k].buf))) {
+            s_lrb[k].buf = NULL; s_lrb[k].cap = 0; return;
+        }
+        s_lrb[k].cap = need;
+    }
+    off_rt_transition(slot, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    D3D12_TEXTURE_COPY_LOCATION dst = {0}, src = {0};
+    dst.pResource = s_lrb[k].buf; dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    dst.PlacedFootprint.Footprint.Format = rbpp == 8 ? DXGI_FORMAT_R16G16B16A16_UNORM : DXGI_FORMAT_R8G8B8A8_UNORM;
+    dst.PlacedFootprint.Footprint.Width = hw;
+    dst.PlacedFootprint.Footprint.Height = hh;
+    dst.PlacedFootprint.Footprint.Depth = 1;
+    dst.PlacedFootprint.Footprint.RowPitch = row;
+    src.pResource = r->res; src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    D3D12_BOX box = { hx, hy, 0, hx + hw, hy + hh, 1 };
+    DRED_MARK_COPY(s_d3d.cmd_list);
+    s_d3d.cmd_list->lpVtbl->CopyTextureRegion(s_d3d.cmd_list, &dst, 0, 0, 0, &src, &box);
+    if (slot == cur_rt) off_rt_transition(slot, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    s_lrb[k].w = dr->rb_w; s_lrb[k].h = dr->rb_h; s_lrb[k].ea = dr->rb_ea; s_lrb[k].pitch = dr->rt_pitch;
+    s_lrb[k].dst_ea = dr->rb_dst_ea; s_lrb[k].dst_pitch = dr->rb_dst_pitch;
+    s_lrb[k].gx = dr->rb_x; s_lrb[k].gy = dr->rb_y; s_lrb[k].hx = hx; s_lrb[k].hy = hy;
+    s_lrb[k].kx = kx; s_lrb[k].ky = ky; s_lrb[k].bpp = rbpp; s_lrb[k].row = row;
+    s_lrb_n++;
+}
+
+/* Start of the next frame, GPU idle (after wb_flush). */
+static void lrb_flush(void)
+{
+    extern uint8_t* vm_base;
+    if (!s_lrb_n || !vm_base) { s_lrb_n = 0; return; }
+    for (int k = 0; k < s_lrb_n; k++) {
+        void* mp = NULL; D3D12_RANGE rr = {0, (SIZE_T)s_lrb[k].cap};
+        if (FAILED(s_lrb[k].buf->lpVtbl->Map(s_lrb[k].buf, 0, &rr, &mp)) || !mp) continue;
+        const u8* b = (const u8*)mp;
+        for (u32 y = 0; y < s_lrb[k].h; y++) {
+            const u32 hr = (u32)((s_lrb[k].gy + y) * s_lrb[k].ky) - s_lrb[k].hy;
+            for (u32 x = 0; x < s_lrb[k].w; x++) {
+                const u32 hc = (u32)((s_lrb[k].gx + x) * s_lrb[k].kx) - s_lrb[k].hx;
+                u8 g[4];
+                if (s_lrb[k].bpp == 8) {
+                    const uint16_t* q = (const uint16_t*)(b + (u64)hr * s_lrb[k].row + hc * 8u);
+                    g[0] = (u8)((q[3] + 128u) / 257u); g[1] = (u8)((q[0] + 128u) / 257u);
+                    g[2] = (u8)((q[1] + 128u) / 257u); g[3] = (u8)((q[2] + 128u) / 257u);
+                } else {
+                    const u8* q = b + (u64)hr * s_lrb[k].row + hc * 4u;
