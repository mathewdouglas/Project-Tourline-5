+static u64 s_vwatch_hits, s_vwatch_bytes, s_vwatch_bad;
+static int vc_watch_mode(void)
+{
+    static int mode = -1;
+    if (mode < 0) {
+        const char* e = getenv("RSX_VTXCACHE_WRITE_WATCH");
+        mode = e ? atoi(e) : 0;
+        if (mode < 0 || mode > 2) mode = 0;
+        extern u8* vm_base;
+        if (mode) {
+            if (!rsx_ww_init(&s_vwatch, vm_base, 0x100000000ull)) s_vwatch.failed = 1;
+            fprintf(stderr, "[write-watch] vertex cache mode %d (2 verifies every hit)\n", mode);
+        }
+    }
+    return mode;
+}
+static void vc_watch_stats(void)
+{
+    if (!vc_watch_mode()) return;
+    fprintf(stderr, "[write-watch] cumulative hits=%llu clean-bytes=%llu queries=%llu dirty-pages=%llu failures=%llu mismatches=%llu fallback=%d\n",
+            s_vwatch_hits, s_vwatch_bytes, s_vwatch.queries, s_vwatch.dirty_pages,
