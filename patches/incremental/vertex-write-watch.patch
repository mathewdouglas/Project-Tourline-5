--- /dev/null
+++ b/libs/video/rsx_write_watch.h
@@ -0,0 +1,110 @@
+/* Windows page-write tracking for renderer caches. Single renderer owner.
+ * Inspired by MormonFTP-hub/gt5-recomp's shared page generations; implemented
+ * independently for this backend's raw vertex streams and IO-page mappings.
+ *
+ * All consumers MUST share this state: resetting Windows' bits independently
+ * would hide writes from another entry using the same page. Harvest before
+ * copying/comparing, never after: writes during that read remain detectable.
+ * Keep each entry's exact resolved ranges, since IO mappings can change even
+ * when the new pages have not been written. Failure disables skipping for the
+ * session. No guest-store instrumentation or page protections are installed.
+ */
+#ifndef RSX_WRITE_WATCH_H
+#define RSX_WRITE_WATCH_H
+#include <windows.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define RSX_WW_RANGES 10u
+#define RSX_WW_MAX_BYTES (8u << 20)
+#define RSX_WW_QUERY_PAGES ((RSX_WW_MAX_BYTES >> 12) + 2u)
+typedef struct { uint32_t ea, len; } RsxWwRange;
+typedef struct {
+    uint64_t stamp, cookie;
+    uint32_t count;
+    RsxWwRange range[RSX_WW_RANGES];
+} RsxWwSnapshot;
+typedef struct {
+    unsigned char* base;
+    uint64_t size, serial, cookie;
+    uint64_t* pages;
+    void* written[RSX_WW_QUERY_PAGES];
+    uint64_t queries, dirty_pages, failures;
+    int failed;
+} RsxWriteWatch;
+
+static void rsx_ww_close(RsxWriteWatch* w)
+{
+    free(w->pages); w->pages = NULL; w->base = NULL;
+    ++w->cookie; /* invalidate snapshots even when the same VA is reused */
+}
+static int rsx_ww_init(RsxWriteWatch* w, unsigned char* base, uint64_t size)
+{
+    rsx_ww_close(w);
+    w->failed = 0; w->serial = 1; w->size = size;
+    if (!base || ((uintptr_t)base & 4095u) || !size || size > 0x100000000ull) return 0;
+    w->pages = (uint64_t*)calloc((size_t)((size + 4095u) >> 12), sizeof(uint64_t));
+    if (!w->pages) return 0;
+    w->base = base;
+    return 1;
+}
+static int rsx_ww_fail(RsxWriteWatch* w)
+{
+    w->failed = 1; ++w->failures;
+    return 0;
+}
+static int rsx_ww_harvest(RsxWriteWatch* w, const RsxWwRange* r, uint32_t count)
+{
+    if (!w->pages || w->failed || !count || count > RSX_WW_RANGES) return 0;
+    uint64_t total = 0;
+    /* Validate everything before any reset. */
+    for (uint32_t i = 0; i < count; ++i) {
+        total += r[i].len;
+        if (!r[i].len || (uint64_t)r[i].ea + r[i].len > w->size || total > RSX_WW_MAX_BYTES)
+            return 0;
+    }
+    for (uint32_t i = 0; i < count; ++i) {
+        const uint64_t lo = (uint64_t)r[i].ea & ~4095ull;
+        const uint64_t hi = ((uint64_t)r[i].ea + r[i].len + 4095u) & ~4095ull;
+        ULONG_PTR n = RSX_WW_QUERY_PAGES;
+        ULONG gran = 0;
+        ++w->queries;
+        if (GetWriteWatch(WRITE_WATCH_FLAG_RESET, w->base + lo, (SIZE_T)(hi - lo),
+                          w->written, &n, &gran) || gran != 4096u || n > RSX_WW_QUERY_PAGES)
+            return rsx_ww_fail(w);
+        if (n) {
+            if (++w->serial == 0) return rsx_ww_fail(w);
+            for (ULONG_PTR k = 0; k < n; ++k) {
+                const uintptr_t p = (uintptr_t)w->written[k];
+                if (p < (uintptr_t)w->base + lo || p >= (uintptr_t)w->base + hi || (p & 4095u))
+                    return rsx_ww_fail(w);
+                w->pages[(p - (uintptr_t)w->base) >> 12] = w->serial;
+            }
+            w->dirty_pages += n;
+        }
+    }
+    return 1;
+}
+/* Call immediately BEFORE the bytes that this snapshot describes are read. */
+static int rsx_ww_begin(RsxWriteWatch* w, const RsxWwRange* r, uint32_t count, RsxWwSnapshot* s)
+{
+    s->stamp = 0;
+    if (!rsx_ww_harvest(w, r, count)) return 0;
+    s->stamp = w->serial; s->cookie = w->cookie; s->count = count;
+    memcpy(s->range, r, count * sizeof(*r));
+    return 1;
+}
+static int rsx_ww_same(RsxWriteWatch* w, const RsxWwRange* r, uint32_t count, const RsxWwSnapshot* s)
+{
+    if (!s->stamp || s->cookie != w->cookie || count != s->count || count > RSX_WW_RANGES ||
+        memcmp(s->range, r, count * sizeof(*r)) || !rsx_ww_harvest(w, r, count)) return 0;
+    for (uint32_t i = 0; i < count; ++i) {
+        const uint64_t first = (uint64_t)r[i].ea >> 12;
+        const uint64_t end = ((uint64_t)r[i].ea + r[i].len + 4095u) >> 12;
+        for (uint64_t p = first; p < end; ++p)
+            if (w->pages[p] > s->stamp) return 0;
+    }
+    return 1;
+}
+#endif
