+/* Resolve every IO page, not only the first: guest mappings need not be
+ * contiguous, and a remap must invalidate a snapshot of otherwise clean pages. */
+static u32 vraw_watch_ranges(u32 loc, u32 off, u32 len, RsxWwRange r[RSX_WW_RANGES])
+{
+    extern u32 cellGcmResolveLocated(int local, u32 offset);
+    if (!len || len > RSX_WW_MAX_BYTES || (u64)off + len > 0x100000000ull) return 0;
+    u32 count = 0;
+    while (len) {
+        u32 in = off & 0xFFFFFu, n = 0x100000u - in;
+        if (n > len) n = len;
+        const u32 ea = cellGcmResolveLocated(loc ? 0 : 1, off & ~0xFFFFFu);
+        if (ea == 0xFFFFFFFFu || (u64)ea + in + n > 0x100000000ull) return 0;
+        const u32 start = ea + in;
+        if (count && (u64)r[count - 1].ea + r[count - 1].len == start) r[count - 1].len += n;
+        else {
+            if (count == RSX_WW_RANGES) return 0;
+            r[count].ea = start; r[count].len = n; ++count;
+        }
+        off += n; len -= n;
+    }
+    return count;
+}
+static void vraw_watch_begin(u32 loc, u32 off, u32 len, RsxWwSnapshot* out)
+{
+    out->stamp = 0;
+    if (!vc_watch_mode()) return;
+    RsxWwRange ranges[RSX_WW_RANGES];
+    const u32 count = vraw_watch_ranges(loc, off, len, ranges);
+    rsx_ww_begin(&s_vwatch, ranges, count, out);
+}
