+    for (int k = 0; k < MAX_SPURS_INST; k++) {
+        if (!s_inst[k].ea || (s_inst[k].ea & ~127u) != line) continue;
+        const u8* r = vm_base + s_inst[k].ea + SPURS_WKL_READY1;
