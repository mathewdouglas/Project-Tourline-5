+#define MV_CMASK_WR 0x200u
+#define MV_SENTINEL "30000.0"   /* in the target: no draw wrote a vector here */
+/* The pixel shader of a MV_CMASK_RT pipeline: the program as generated,
+ * renamed, under a main that also returns the draw's vector at SV_TARGET<nrt>:
+ * T (rsx_mvt, per draw, vp_record_cb) applied to the pixel's guest position
+ * and depth, minus that position, in host pixels; the sentinel when the draw
+ * has no T. Returns 0 when the text has an unexpected shape (no pipeline then). */
+static int mv_wrap_hlsl(char* hlsl, size_t cap, int nrt)
+{
+    static const char full_b1[] =
+        "cbuffer PSConstants : register(b1) { float4 rsx_texscale[4];"
+        " float4 rsx_alphatest; float4 fp_constants[256]; float4 rsx_fogstate;"
+        " float4 rsx_texexpand[4]; float4 rsx_texscale_hi[6]; float4 rsx_mvt[4]; };";
+    /* b1: the whole slot, rsx_mvt last (at byte VP_FPCB_BASE). The shorter
+     * declarations are prefixes of this one. */
+    char* cb = strstr(hlsl, "cbuffer PSConstants : register(b1) {");
+    if (cb) {
+        char* ce = strstr(cb, "};");
+        if (!ce || !strstr(cb, "float4 rsx_texscale[4];") || (size_t)(ce - cb) > sizeof full_b1) return 0;
+        const size_t oldlen = (size_t)(ce + 2 - cb), newlen = strlen(full_b1), tail = strlen(ce + 2) + 1;
+        if ((size_t)(cb - hlsl) + newlen + tail > cap) return 0;
+        memmove(cb + newlen, cb + oldlen, tail);
+        memcpy(cb, full_b1, newlen);
+    } else {
+        const size_t l = strlen(hlsl), dl = strlen(full_b1);
+        if (l + dl + 2 > cap) return 0;
+        memmove(hlsl + dl + 1, hlsl, l + 1);
+        memcpy(hlsl, full_b1, dl); hlsl[dl] = '\n';
+    }
+    int targets = 1;
+    char* m = strstr(hlsl, "float4 main(PSInput input) : SV_TARGET {");
+    if (m) {
+        static const char from[] = "float4 main(PSInput input) : SV_TARGET {";
+        static const char to[] = "float4 rsx_mv_inner(PSInput input) {";
+        memmove(m + strlen(to), m + strlen(from), strlen(m + strlen(from)) + 1);
+        memcpy(m, to, strlen(to));
+    } else {
+        m = strstr(hlsl, "PSOutput main(PSInput input) {");
+        if (!m) return 0;
+        static const char to[] = "PSOutput rsx_mv_inner(PSInput input) {";
+        static const char from[] = "PSOutput main(PSInput input) {";
+        memmove(m + strlen(to), m + strlen(from), strlen(m + strlen(from)) + 1);
+        memcpy(m, to, strlen(to));
+        targets = 0;
+        for (const char* q = strstr(hlsl, "struct PSOutput"); q && (q = strstr(q, ": SV_TARGET")); q++) targets++;
+        if (targets < 1) return 0;
+    }
+    if (strstr(hlsl, "main(PSInput input)")) return 0;   /* more than one entry: leave it */
+    char w[2048]; int n = 0;
+    n += snprintf(w + n, sizeof w - n,
+        "\nfloat2 rsx_mv(float4 p) {"
+        " if (rsx_mvt[3].z == 0) return float2(" MV_SENTINEL ", " MV_SENTINEL ");"
+        " float2 g = p.xy * rsx_mvt[3].xy; float4 h = float4(g, p.z, 1);"
+        " float3 q = float3(dot(rsx_mvt[0], h), dot(rsx_mvt[1], h), dot(rsx_mvt[2], h));"
+        " if (q.z <= 1e-6) return float2(" MV_SENTINEL ", " MV_SENTINEL ");"
+        " return (q.xy / q.z - g) / rsx_mvt[3].xy; }\n"
+        "struct RsxMvOut {");
+    const int keep = targets < nrt ? targets : nrt;
+    for (int t = 0; t < keep; t++) n += snprintf(w + n, sizeof w - n, " float4 t%d : SV_TARGET%d;", t, t);
+    n += snprintf(w + n, sizeof w - n, " float2 mv : SV_TARGET%d; };\n"
+                  "RsxMvOut main(PSInput input) { RsxMvOut o;", nrt);
+    if (m == strstr(hlsl, "float4 rsx_mv_inner"))
+        n += snprintf(w + n, sizeof w - n, " o.t0 = rsx_mv_inner(input);");
+    else {
+        n += snprintf(w + n, sizeof w - n, " PSOutput r = rsx_mv_inner(input);");
+        for (int t = 0; t < keep; t++) n += snprintf(w + n, sizeof w - n, " o.t%d = r.t%d;", t, t);
+    }
+    n += snprintf(w + n, sizeof w - n, " o.mv = rsx_mv(input.position); return o; }\n");
+    if (n <= 0 || (size_t)n >= sizeof w || strlen(hlsl) + (size_t)n + 1 > cap) return 0;
+    strcat(hlsl, w);
+    return 1;
+}
