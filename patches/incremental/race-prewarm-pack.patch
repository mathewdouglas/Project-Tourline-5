+    if (!pso_pack_enabled()) return 0;
+    char path[700]; snprintf(path, sizeof path, "%s/race-pack-v1.bin", dir);
+    LARGE_INTEGER t0, t1, freq; QueryPerformanceFrequency(&freq); QueryPerformanceCounter(&t0);
+    HANDLE file = CreateFileA(path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, FILE_FLAG_SEQUENTIAL_SCAN, NULL);
+    if (file == INVALID_HANDLE_VALUE) return 0;
+    LARGE_INTEGER sz;
+    if (!GetFileSizeEx(file, &sz) || sz.QuadPart < 40 || sz.QuadPart > PSO_PACK_MAX) { CloseHandle(file); return 0; }
+    unsigned char* bytes = (unsigned char*)malloc((size_t)sz.QuadPart);
+    DWORD got = 0; BOOL ok = bytes && ReadFile(file, bytes, (DWORD)sz.QuadPart, &got, NULL);
+    CloseHandle(file);
+    QueryPerformanceCounter(&t1);
+    long long read_us = (long long)((t1.QuadPart - t0.QuadPart) * 1000000ll / freq.QuadPart);
+    InterlockedAdd64(&s_prep_us_pack, (LONG64)read_us);
+    if (!ok || got != (DWORD)sz.QuadPart) { free(bytes); return 0; }
+    u64 magic = 0, index_fnv = 0, payload_fnv = 0; u32 version = 0, count = 0, codes = 0;
+    memcpy(&magic, bytes, 8); memcpy(&version, bytes + 8, 4); memcpy(&count, bytes + 12, 4);
+    memcpy(&codes, bytes + 16, 4);
+    memcpy(&index_fnv, bytes + 24, 8); memcpy(&payload_fnv, bytes + 32, 8);
+    if (magic != PSO_PACK_MAGIC || version != 1 || !count || count > PSO_RACE_SEEN || codes > PSO_RACE_SEEN * 2u) {
+        free(bytes); return 0;
+    }
+    size_t tables = 40u + (size_t)count * 32u + (size_t)codes * 16u;
+    if (tables > (size_t)sz.QuadPart) { free(bytes); return 0; }
+    const unsigned char* payload = bytes + tables;
+    size_t payload_n = (size_t)sz.QuadPart - tables;
+    if (pso_hash_bytes(1469598103934665603ull, payload, payload_n) != payload_fnv) { free(bytes); return 0; }
+    u64* listed = (u64*)malloc(sizeof(u64) * ((size_t)count + 1u));
+    u32 n = listed ? pso_read_hashes(index, listed, count + 1u) : 0;
+    if (!listed || n != count) { free(listed); free(bytes); return 0; }
+    PsoPackItem* items = (PsoPackItem*)calloc(count, sizeof(PsoPackItem));
+    if (!items) { free(listed); free(bytes); return 0; }
+    for (u32 i = 0; i < count; i++) {
+        const unsigned char* rec = bytes + 40 + (size_t)i * 32u;
+        u64 hash = 0; u32 recipe_off = 0, recipe_len = 0, vs_id = 0, ps_id = 0, blob_off = 0, blob_len = 0;
+        memcpy(&hash, rec, 8); memcpy(&recipe_off, rec + 8, 4); memcpy(&recipe_len, rec + 12, 4);
+        memcpy(&vs_id, rec + 16, 4); memcpy(&ps_id, rec + 20, 4);
+        memcpy(&blob_off, rec + 24, 4); memcpy(&blob_len, rec + 28, 4);
+        PsoPackItem* item = &items[i];
+        item->hash = hash;   /* a zero or repeated hash fails the membership check below */
+        if (recipe_len == sizeof(PsoWarmRecipe) && (size_t)recipe_off + recipe_len <= payload_n) {
+            item->recipe = payload + recipe_off;
+            item->recipe_len = recipe_len;
+        }
+        if (vs_id != PSO_PACK_NO_CODE && vs_id < codes) {
+            const unsigned char* c = bytes + 40 + (size_t)count * 32u + (size_t)vs_id * 16u;
+            u32 off = 0, len = 0; memcpy(&off, c + 8, 4); memcpy(&len, c + 12, 4);
+            if (len && len <= PSO_WARM_CODE_MAX && (size_t)off + len <= payload_n) { item->vs = payload + off; item->vs_len = len; }
+        }
+        if (ps_id != PSO_PACK_NO_CODE && ps_id < codes) {
+            const unsigned char* c = bytes + 40 + (size_t)count * 32u + (size_t)ps_id * 16u;
+            u32 off = 0, len = 0; memcpy(&off, c + 8, 4); memcpy(&len, c + 12, 4);
+            if (len && len <= PSO_WARM_CODE_MAX && (size_t)off + len <= payload_n) { item->ps = payload + off; item->ps_len = len; }
+        }
+        if (blob_len && (size_t)blob_off + blob_len <= payload_n) { item->blob = payload + blob_off; item->blob_len = blob_len; }
+    }
+    if (!pso_pack_match_and_order(items, count, listed, index_fnv)) {
+        free(listed); free(items); free(bytes); return 0;
+    }
+    free(listed);
+    s_pack_bytes = bytes; s_pack_items = items; s_pack_n = count; s_pack_hit = 1;
+    InterlockedIncrement(&s_pack_hits);
+    fprintf(stderr, "[race-prewarm] pack hit: recipes=%u bytes=%u read_ms=%lld\n",
+            count, (unsigned)sz.QuadPart, read_us / 1000);
+    return 1;
+}
+static int pso_pack_matches(const char* dir, const char* index) {
+    return s_pack_hit && s_pack_items && dir && index &&
+        strcmp(s_pack_dir, dir) == 0 && strcmp(s_pack_index, index) == 0;
+}
+/* Background warmup, race phase: bind once, then one pipeline per call. */
+static u32 s_prewarm_thr_n;
+static int pso_startup_bind_race_pack(const char* dir, const char* index) {
+    if (s_prewarm_thr_n) return 0;   /* helpers of a race load may still hold the pack */
+    if (!pso_pack_matches(dir, index) && !pso_pack_bind(dir, index)) return 0;
+    s_pack_startup_on = 1;
+    s_pack_startup_i = 0;
+    fprintf(stderr, "[shader-warmup] race pack: recipes=%u\n", s_pack_n);
+    return 1;
+}
+/* Returns 1 when no items remain. */
+static int pso_startup_pack_one(u32* ready) {
+    if (!s_pack_startup_on || !s_pack_hit || !s_pack_items || s_pack_startup_i >= s_pack_n) return 1;
+    PsoPackItem* it = &s_pack_items[s_pack_startup_i++];
+    int packed = pso_prepare_packed(it);
+    int ok = packed > 0 || (packed == 0 && pso_race_recipe(it->hash));
+    if (ok) { s_pso_warm_loaded++; if (ready) (*ready)++; }
+    else s_pso_warm_rejected++;
+    return 0;
+}
+static int pso_pack_append(unsigned char** buf, size_t* len, size_t* cap, const void* data, size_t n) {
+    if (n > PSO_PACK_MAX || *len > PSO_PACK_MAX - n) return 0;
+    if (*len + n > *cap) {
+        size_t ncap = *cap ? *cap : (size_t)1024 * 1024;
+        while (ncap < *len + n) {
+            if (ncap > PSO_PACK_MAX / 2) { ncap = PSO_PACK_MAX; break; }
+            ncap *= 2;
+        }
+        if (ncap < *len + n) return 0;
+        unsigned char* grown = (unsigned char*)realloc(*buf, ncap);
+        if (!grown) return 0;
+        *buf = grown; *cap = ncap;
+    }
+    if (n && data) memcpy(*buf + *len, data, n);
+    *len += n;
+    return 1;
+}
+static int pso_pack_align(unsigned char** buf, size_t* len, size_t* cap) {
+    unsigned char zeros[16]; size_t pad = (16u - (*len & 15u)) & 15u;
+    memset(zeros, 0, sizeof zeros);
+    return pso_pack_append(buf, len, cap, zeros, pad);
+}
+typedef struct { u64 hash; u32 off, len, next; } PsoPackCode;
+static u32 pso_pack_code_id(PsoPackCode* codes, u32* ncodes, u32 max, u32* buckets, u32 nbuckets,
+                            unsigned char** payload, size_t* plen, size_t* pcap,
+                            u64 hash, const void* data, u32 bytes) {
+    u32 b = (u32)(hash ^ (hash >> 32)) & (nbuckets - 1);
+    for (u32 c = buckets[b]; c != PSO_PACK_NO_CODE; c = codes[c].next)
+        if (codes[c].hash == hash && codes[c].len == bytes) return c;
+    if (*ncodes >= max || !pso_pack_align(payload, plen, pcap)) return PSO_PACK_NO_CODE;
+    u32 id = *ncodes; size_t off = *plen;
+    if (!pso_pack_append(payload, plen, pcap, data, bytes)) return PSO_PACK_NO_CODE;
+    codes[id].hash = hash; codes[id].off = (u32)off; codes[id].len = bytes; codes[id].next = buckets[b];
+    buckets[b] = id; ++*ncodes;
+    return id;
+}
+/* Any thread: reads the per-file cache, never renderer state. Stops between
+ * pipelines at shutdown, leaving the previous pack in place. */
+static int pso_pack_store(const char* dir, const char* index) {
+    if (!pso_pack_write_enabled() || !dir || !dir[0] || !index || !index[0]) return 0;
+    u64* listed = (u64*)malloc(sizeof(u64) * PSO_RACE_SEEN);
+    if (!listed) return 0;
+    u32 count = pso_read_hashes(index, listed, PSO_RACE_SEEN);
+    if (!count) { free(listed); return 0; }
+    /* Driver blobs live in the shader cache above the warmup directory. */
+    char cache[512];
+    snprintf(cache, sizeof cache, "%s", dir);
+    {
+        char* slash = strrchr(cache, '/'); char* bslash = strrchr(cache, '\\');
+        if (!slash || (bslash && bslash > slash)) slash = bslash;
+        if (slash && slash != cache) *slash = 0; else snprintf(cache, sizeof cache, "shadercache");
+    }
+    typedef struct { u64 hash; u32 recipe_off, recipe_len, vs_id, ps_id, blob_off, blob_len; } PsoPackRec;
+    enum { PSO_PACK_BUCKETS = PSO_RACE_SEEN * 2 };
+    PsoPackCode* codes = (PsoPackCode*)calloc((size_t)count * 2u, sizeof(PsoPackCode));
+    PsoPackRec* recs = (PsoPackRec*)calloc(count, sizeof(PsoPackRec));
+    u32* buckets = (u32*)malloc(sizeof(u32) * PSO_PACK_BUCKETS);
+    unsigned char* payload = NULL; size_t plen = 0, pcap = 0; u32 ncodes = 0; u32 blobs = 0;
+    int failed = !codes || !recs || !buckets;
+    if (buckets) memset(buckets, 0xff, sizeof(u32) * PSO_PACK_BUCKETS);
+    ULONGLONG began = GetTickCount64();
+    for (u32 i = 0; i < count && !failed; i++) {
+        if (s_pso_stopping) { failed = 1; break; }
+        char path[640]; PsoWarmRecipe recipe;
+        snprintf(path, sizeof path, "%s/pso_%016llx.recipe", dir, (unsigned long long)listed[i]);
+        recs[i].hash = listed[i];
+        recs[i].vs_id = recs[i].ps_id = PSO_PACK_NO_CODE;
+        if (pso_warm_read_recipe(path, &recipe) && recipe.hash == listed[i]) {
+            void* vs = pso_warm_read_code(dir, recipe.vs_hash, recipe.vs_bytes);
+            void* ps = pso_warm_read_code(dir, recipe.ps_hash, recipe.ps_bytes);
+            if (vs) recs[i].vs_id = pso_pack_code_id(codes, &ncodes, count * 2u, buckets, PSO_PACK_BUCKETS, &payload, &plen, &pcap, recipe.vs_hash, vs, recipe.vs_bytes);
+            if (ps) recs[i].ps_id = pso_pack_code_id(codes, &ncodes, count * 2u, buckets, PSO_PACK_BUCKETS, &payload, &plen, &pcap, recipe.ps_hash, ps, recipe.ps_bytes);
+            free(vs); free(ps);
+            if (!pso_pack_align(&payload, &plen, &pcap) || !pso_pack_append(&payload, &plen, &pcap, &recipe, sizeof recipe)) failed = 1;
+            else { recs[i].recipe_off = (u32)(plen - sizeof recipe); recs[i].recipe_len = (u32)sizeof recipe; }
+        }
+        if (!failed) {
+            snprintf(path, sizeof path, "%s/pso_%016llx.bin", cache, (unsigned long long)listed[i]);
+            FILE* bf = fopen(path, "rb");
+            if (bf) {
+                long size; u64 header[3];
+                if (!fseek(bf, 0, SEEK_END) && (size = ftell(bf)) > 24 && size <= 32 * 1024 * 1024 && !fseek(bf, 0, SEEK_SET) &&
+                    fread(header, 1, sizeof header, bf) == sizeof header && header[0] == 0x31534F5035505447ull &&
+                    header[1] == (u64)size - sizeof header) {
+                    size_t n = (size_t)header[1];
+                    void* blob = malloc(n);
+                    if (blob && fread(blob, 1, n, bf) == n && pso_hash_bytes(1469598103934665603ull, blob, n) == header[2] &&
+                        pso_pack_align(&payload, &plen, &pcap) && pso_pack_append(&payload, &plen, &pcap, blob, n)) {
+                        recs[i].blob_off = (u32)(plen - n); recs[i].blob_len = (u32)n; blobs++;
+                    }
+                    free(blob);
+                }
+                fclose(bf);
+            }
+        }
+    }
+    const size_t tables = 40u + (size_t)count * 32u + (size_t)ncodes * 16u;
+    if (!failed && (tables + plen > PSO_PACK_MAX || plen > 0xffffffffu)) failed = 1;
+    if (!failed) {
+        /* Header and tables first, then the payload from where it was built. */
+        unsigned char* head = (unsigned char*)calloc(1, tables);
+        char out[700], tmp[740];
+        snprintf(out, sizeof out, "%s/race-pack-v1.bin", dir);
+        snprintf(tmp, sizeof tmp, "%s.%lu.tmp", out, (unsigned long)GetCurrentThreadId());
+        FILE* f = head ? fopen(tmp, "wb") : NULL;
+        if (!f) failed = 1;
+        else {
+            u64 magic = PSO_PACK_MAGIC, index_fnv, payload_fnv; u32 version = 1, flags = 0;
+            index_fnv = pso_hash_bytes(1469598103934665603ull, listed, (size_t)count * 8);
+            payload_fnv = pso_hash_bytes(1469598103934665603ull, payload ? payload : (const unsigned char*)"", plen);
+            memcpy(head, &magic, 8); memcpy(head + 8, &version, 4); memcpy(head + 12, &count, 4);
+            memcpy(head + 16, &ncodes, 4); memcpy(head + 20, &flags, 4);
+            memcpy(head + 24, &index_fnv, 8); memcpy(head + 32, &payload_fnv, 8);
+            for (u32 i = 0; i < count; i++) {
+                unsigned char* rec = head + 40 + (size_t)i * 32u;
+                memcpy(rec, &recs[i].hash, 8); memcpy(rec + 8, &recs[i].recipe_off, 4); memcpy(rec + 12, &recs[i].recipe_len, 4);
+                memcpy(rec + 16, &recs[i].vs_id, 4); memcpy(rec + 20, &recs[i].ps_id, 4);
+                memcpy(rec + 24, &recs[i].blob_off, 4); memcpy(rec + 28, &recs[i].blob_len, 4);
+            }
+            for (u32 c = 0; c < ncodes; c++) {
+                unsigned char* row = head + 40 + (size_t)count * 32u + (size_t)c * 16u;
+                memcpy(row, &codes[c].hash, 8); memcpy(row + 8, &codes[c].off, 4); memcpy(row + 12, &codes[c].len, 4);
+            }
+            int ok = fwrite(head, 1, tables, f) == tables && (!plen || fwrite(payload, 1, plen, f) == plen);
+            if (fclose(f)) ok = 0;
+            if (ok && !s_pso_stopping && MoveFileExA(tmp, out, MOVEFILE_REPLACE_EXISTING)) {
+                InterlockedIncrement(&s_pack_stored);
+                fprintf(stderr, "[race-prewarm] pack stored: recipes=%u codes=%u bytes=%llu blobs=%u elapsed_ms=%llu\n",
+                        count, ncodes, (unsigned long long)(tables + plen), blobs, (unsigned long long)(GetTickCount64() - began));
+            } else { DeleteFileA(tmp); failed = 1; }
+        }
+        free(head);
+    }
+    if (failed) fprintf(stderr, "[race-prewarm] pack store skipped\n");
+    free(payload); free(codes); free(recs); free(buckets); free(listed);
+    return !failed;
+}
+/* After a finished load: write the pack when none matched, or once a run
+ * when the matching one could not serve every member. */
+static int pso_pack_want_store(void) {
+    if (!pso_pack_write_enabled() || s_pso_stopping) return 0;
+    if (!s_pack_hit) return 1;
+    if (!s_pack_stale || s_pack_stale_rewrote) return 0;
+    s_pack_stale_rewrote = 1;
+    return 1;
+}
+static DWORD WINAPI pso_pack_store_thread(LPVOID unused) {
+    (void)unused;
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+    pso_pack_store(s_pack_dir, s_pack_index);
+    return 0;
+}
+static void pso_prep_split_print(void) {
+    fprintf(stderr,"[race-prewarm] recipe preparation split (cumulative, all phases): created=%lld recipe_ms=%lld code_ms=%lld create_ms=%lld (of which blob reads, all callers: %lld ms, pack read: %lld ms) pack_stale=%ld\n",
+            (long long)s_prep_n,(long long)s_prep_us_recipe/1000,(long long)s_prep_us_code/1000,(long long)s_prep_us_create/1000,
+            (long long)s_prep_us_blob/1000,(long long)s_prep_us_pack/1000,(long)s_pack_stale);
+}
+/* Parallel race prewarm (Prologue Phase 221, adapted). One pipeline per
+ * worker turn took longer than the loading gate's budget for a full race
+ * set, so the race started while the set was still filling.
+ * RSX_RACE_PREWARM_THREADS=<n> (2..8, default 4) reads the index once and
+ * prepares it on n below-normal helper threads; the pso-worker keeps serving
+ * demand jobs meanwhile. The last helper releases the gate. =1 restores the
+ * one-recipe-per-turn worker path. A new race load or shutdown stops the
+ * helpers between recipes. Helpers only call the pipeline creation path the
+ * worker already used (thread-safe: its tables take s_pso_warm_lock and its
+ * files are written under per-thread temporary names). */
+#define PSO_PREWARM_THREADS_MAX 8
+static HANDLE s_prewarm_thr[PSO_PREWARM_THREADS_MAX + 1];   /* helpers, or one pack writer */
+static u32 s_prewarm_helpers;
+static u64* s_prewarm_list;
+static u32 s_prewarm_list_n;
+static volatile LONG s_prewarm_next, s_prewarm_active, s_prewarm_loaded, s_prewarm_rejected, s_prewarm_gen;
+static ULONGLONG s_prewarm_began;
+static int pso_prewarm_threads(void)
+{
+    const char* e = getenv("RSX_RACE_PREWARM_THREADS");
+    int n = e ? atoi(e) : 4;
+    return n < 1 ? 1 : n > PSO_PREWARM_THREADS_MAX ? PSO_PREWARM_THREADS_MAX : n;
+}
+static DWORD WINAPI pso_prewarm_helper(LPVOID arg)
+{
+    const LONG gen = (LONG)(LONG_PTR)arg;
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+    int complete = 0;
+    for (;;) {
+        if (s_pso_stopping || s_prewarm_gen != gen) break;
+        LONG i = InterlockedIncrement(&s_prewarm_next) - 1;
+        if (i < 0 || (u32)i >= s_prewarm_list_n) { complete = 1; break; }
+        int ok = 0;
+        if (s_pack_hit && s_pack_items && (u32)i < s_pack_n) {
+            int packed = pso_prepare_packed(&s_pack_items[i]);
+            if (packed > 0) ok = 1;
+            else if (packed == 0) ok = pso_race_recipe(s_pack_items[i].hash);
+        } else if (s_prewarm_list) {
+            ok = pso_race_recipe(s_prewarm_list[i]);
+        }
+        if (ok) { InterlockedIncrement(&s_prewarm_loaded); InterlockedIncrement(&s_race_loaded); }
+        else { InterlockedIncrement(&s_prewarm_rejected); InterlockedIncrement(&s_race_rejected); }
+        InterlockedIncrement(&g_rsx_race_load_done);
+    }
+    if (InterlockedDecrement(&s_prewarm_active) == 0 && s_prewarm_gen == gen) {
+        if (s_race_ready) SetEvent(s_race_ready);
+        fprintf(stderr,"[race-prewarm] finished: ready=%ld rejected=%ld elapsed_ms=%llu threads=%u (%s)\n",
+                (long)s_prewarm_loaded,(long)s_prewarm_rejected,(unsigned long long)(GetTickCount64()-s_prewarm_began),
+                s_prewarm_helpers,s_pack_hit?"pack":"files");
+        pso_prep_split_print();
+        if (complete && !s_pso_stopping && s_prewarm_gen == gen) {
+            if (pso_pack_want_store()) pso_pack_store(s_pack_dir, s_pack_index);
+            /* The worker joins this thread, then drops the pack bytes. */
+            AcquireSRWLockExclusive(&s_pso_queue_lock);
+            InterlockedExchange(&s_pack_release_request, 1);
+            WakeConditionVariable(&s_pso_queue_cv);
+            ReleaseSRWLockExclusive(&s_pso_queue_lock);
+        }
+    }
+    return 0;
+}
+/* Join helpers (and a pack writer) of an earlier load: worker thread only. */
+static void pso_prewarm_join(void)
+{
+    InterlockedIncrement(&s_prewarm_gen);
+    for (u32 i = 0; i < s_prewarm_thr_n; i++) { WaitForSingleObject(s_prewarm_thr[i], INFINITE); CloseHandle(s_prewarm_thr[i]); }
+    s_prewarm_thr_n = 0; s_prewarm_helpers = 0;
+    InterlockedExchange(&s_pack_release_request, 0);
+}
+/* Start helpers for the race index; 0 when the single-thread path should run
+ * instead. A pack that hits stays bound for that path. */
+static int pso_prewarm_start(const char* dir, const char* index)
+{
+    pso_prewarm_join();
+    /* The menu-time warmup may already have read this pack. Keep it. */
+    if (!pso_pack_matches(dir, index)) pso_pack_bind(dir, index);
+    const int n = pso_prewarm_threads();
+    if (n < 2) return 0;
+    u32 count = 0;
+    if (s_pack_hit) count = s_pack_n;
+    else {
+        if (!s_prewarm_list) s_prewarm_list = (u64*)malloc(sizeof(u64) * PSO_RACE_SEEN);
+        if (!s_prewarm_list) return 0;
+        count = pso_read_hashes(index, s_prewarm_list, PSO_RACE_SEEN);
+        if (!count) return 0;
+    }
+    s_prewarm_list_n = count; s_prewarm_loaded = s_prewarm_rejected = 0;
+    InterlockedExchange(&s_prewarm_next, 0);
+    s_prewarm_began = GetTickCount64();
+    const LONG gen = s_prewarm_gen;
+    InterlockedExchange(&g_rsx_race_load_done, 0);
+    InterlockedExchange(&g_rsx_race_load_total, (LONG)count);
+    /* Count every helper before the first runs: the one that brings the
+     * count to zero releases the gate. */
+    InterlockedExchange(&s_prewarm_active, n + 1);
+    for (int i = 0; i < n; i++) {
+        HANDLE t = CreateThread(NULL, 0, pso_prewarm_helper, (LPVOID)(LONG_PTR)gen, 0, NULL);
+        if (t) { s_prewarm_thr[s_prewarm_thr_n++] = t; s_prewarm_helpers++; }
+        else InterlockedDecrement(&s_prewarm_active);
+    }
+    if (!s_prewarm_thr_n) {
+        InterlockedExchange(&s_prewarm_active, 0);
+        InterlockedExchange(&g_rsx_race_load_total, 0);
+        return 0;
+    }
+    fprintf(stderr, "[race-prewarm] %u helper threads for %u recipes (%s)\n", s_prewarm_thr_n, count, s_pack_hit ? "pack" : "files");
+    /* Drop the starter's own count. Helpers that had already finished could
+     * not reach zero, so the gate is released here in that case; the pack is
+     * then written or dropped by the next load instead. */
+    if (InterlockedDecrement(&s_prewarm_active) == 0) {
+        if (s_race_ready) SetEvent(s_race_ready);
