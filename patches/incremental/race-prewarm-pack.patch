+static u32 pso_read_hashes(const char* index, u64* out, u32 cap) {
+    enum { PSO_HASH_TABLE = PSO_RACE_SEEN * 4 };
+    FILE* f = fopen(index, "r"); if (!f) return 0;
+    u64* seen = (u64*)calloc(PSO_HASH_TABLE, sizeof(u64));
+    if (!seen) { fclose(f); return 0; }
+    char line[64]; unsigned long long h; u32 n = 0;
+    while (n < cap && n < PSO_RACE_SEEN + 1u && fgets(line, sizeof line, f)) {
+        if (sscanf(line, "%llx", &h) != 1 || !h) continue;
+        u32 k = (u32)(h ^ (h >> 32)) & (PSO_HASH_TABLE - 1);
+        while (seen[k] && seen[k] != (u64)h) k = (k + 1) & (PSO_HASH_TABLE - 1);
