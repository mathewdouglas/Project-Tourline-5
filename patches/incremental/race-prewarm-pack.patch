+/* A pack survives maintenance reordering the same race membership. Verify
+ * its own ordered checksum, reject missing or duplicate members, and reorder
+ * the bound items to the live priority list. Payload ownership stays put. */
+static int pso_pack_index_compare(const void* a, const void* b) {
+    u64 x = ((const PsoPackItem*)a)->hash, y = ((const PsoPackItem*)b)->hash;
+    return (x > y) - (x < y);
+}
+static int pso_pack_match_and_order(PsoPackItem* items, u32 count, const u64* listed, u64 expected) {
+    if (!items || !listed || !count || count > PSO_RACE_SEEN) return 0;
+    u64 hash = 1469598103934665603ull;
+    for (u32 i = 0; i < count; ++i) hash = pso_hash_bytes(hash, &items[i].hash, sizeof(u64));
+    if (hash != expected) return 0;
+    qsort(items, count, sizeof *items, pso_pack_index_compare);
+    for (u32 i = 0; i < count; ++i)
+        if (!items[i].hash || (i && items[i].hash == items[i-1].hash)) return 0;
+    PsoPackItem* ordered = (PsoPackItem*)malloc((size_t)count * sizeof *ordered);
+    unsigned char* seen = (unsigned char*)calloc(count, 1);
+    if (!ordered || !seen) { free(ordered); free(seen); return 0; }
+    int ok = 1;
+    for (u32 i = 0; i < count; ++i) {
+        PsoPackItem key; memset(&key, 0, sizeof key); key.hash = listed[i];
+        PsoPackItem* found = (PsoPackItem*)bsearch(&key, items, count, sizeof *items, pso_pack_index_compare);
+        if (!found || seen[found-items]) { ok = 0; break; }
+        seen[found-items] = 1; ordered[i] = *found;
+    }
+    if (ok) memcpy(items, ordered, (size_t)count * sizeof *items);
+    free(ordered); free(seen); return ok;
