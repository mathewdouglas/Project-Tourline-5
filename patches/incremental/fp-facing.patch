  * are left out otherwise so that a program which does not use them still
  * links against a vertex shader that does not output them. */
 static int s_fp_uses_tc89;
+/* The program reads FACING (input 0xE: +1 for a face the guest calls front,
+ * -1 for a back face). It used to read 0: GT5's Ford Mark IV body multiplies
+ * its normal by FACING for two-sided lighting, so its normal, paint lookup and
+ * reflection all came out zero (#30: a white or dull maroon car, not red).
+ * D3D12's SV_IsFrontFace has the opposite sense here (the port's viewport
+ * flips the picture vertically, which reverses winding): measured on that car,
+ * front ? +1 : -1 gives chrome-like white streaks, the inverse matches RPCS3.
+ * RSX_FP_FACING=0: zero, as before; =3: the uninverted sign (test). The
+ * interpreter takes the same sign (RSX_INTERP_FACE_SIGN). */
+static int s_fp_uses_facing;
+static int fp_facing_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("RSX_FP_FACING"); on = !e ? 1 : (e[0] == '0' ? 0 : (e[0] == '3' ? 3 : 1)); }
+    return on;
+}
 static const char* input_expr(u32 input_src)
