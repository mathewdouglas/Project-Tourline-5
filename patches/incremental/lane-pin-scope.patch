+/* SPURS_LANE_PIN_SCOPE=1 (GT5's default, with SPURS_LANE_PIN=2): which
+ * workloads' lanes are pinned follows the race scope the renderer reports
+ * (g_spurs_race_scope, from its RSX_SCOPE_LABELS): SPURS_LANE_PIN_RACE
+ * (default "0,1", the SPURS_LANE_CPU_WIDS default) in a race,
+ * SPURS_LANE_PIN_MENU (default "4") elsewhere. Gran Turismo 5's car list
+ * waits on workload 4's four lanes; pinned they cut its frames 8-9% within
+ * one boot, while races were no better (GT5 Phase 46). Lanes of other
+ * workloads run free. =0: the fixed SPURS_LANE_CPU_WIDS set. */
+volatile long g_spurs_race_scope;
+static int spurs_lane_pin_scope_on(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char* e = getenv("SPURS_LANE_PIN_SCOPE");
+        const char* pe = getenv("SPURS_LANE_PIN");
+        on = (e && *e == '1' && pe && atoi(pe) >= 2 && !getenv("SPURS_LANE_CPUS")) ? 1 : 0;
+    }
+    return on;
+}
