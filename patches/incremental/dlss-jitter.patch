+/* ---- [jitter] Sub-pixel camera jitter (DLSS step 4), walker side ----
+ * RSX_JITTER=<n>: scene draws (depth-tested draws into the last judged scene
+ * target, or into its zeta) are shifted by a Halton(2,3) offset of n phases,
+ * in host pixels in [-0.5, 0.5), one phase per frame judged a scene. The
+ * shift is a clip-space offset (vp_posoffset.xy times w), so it moves every
+ * scene viewport, the rear mirror too, by the same pixels. Motion vectors
+ * stay unjittered: they come from the guest's own matrices.
+ * RSX_JITTER_FIXED=x,y: a constant offset in host pixels instead (tests: a
+ * large one shows a band of clear colour at the scene's edge, sign included).
+ * RSX_JITTER_LOG=1: the offset every 120 phases. */
+static struct { int on, n, fixed, log, nf, per; float fx, fy, fl[8][2]; u32 phase; float cur[2]; u32 cur_i, draws, seen; } s_jit = { -1 };
+static float jit_halton(u32 i, u32 b)
+{
+    float f = 1.0f, r = 0.0f;
+    while (i) { f /= (float)b; r += f * (float)(i % b); i /= b; }
+    return r;
+}
+static int jit_on(void)
+{
+    if (s_jit.on < 0) {
+        const char* e = getenv("RSX_JITTER");
+        s_jit.n = e ? atoi(e) : 0;
+        const char* f = getenv("RSX_JITTER_FIXED");
+        while (f && s_jit.nf < 8 && sscanf(f, "%f,%f", &s_jit.fl[s_jit.nf][0], &s_jit.fl[s_jit.nf][1]) == 2) {
+            s_jit.nf++; f = strchr(f, ';'); if (f) f++;
+        }
+        if (s_jit.nf) { s_jit.fixed = 1; s_jit.fx = s_jit.fl[0][0]; s_jit.fy = s_jit.fl[0][1]; }
+        const char* pf = getenv("RSX_JITTER_FIXED_FRAMES");
+        s_jit.per = pf && atoi(pf) > 0 ? atoi(pf) : 1;
+        s_jit.log = getenv("RSX_JITTER_LOG") != NULL;
+        s_jit.on = s_jit.n > 0 || s_jit.fixed;
+        if (s_jit.on)
+            fprintf(stderr, "[jitter] on: %s %d, x %.3f y %.3f host px%s", s_jit.fixed ? "fixed" : "Halton(2,3) phases",
+                    s_jit.fixed ? 0 : s_jit.n, (double)s_jit.fx, (double)s_jit.fy, "\n");
+    }
+    return s_jit.on;
+}
+/* At a judged frame's end: hand the offset its draws used to the replay, pick the next. */
+static void jit_frame(void)
+{
+    if (!jit_on()) return;
+    if (s_jit.log && (s_jit.seen++ % 120) == 0)
+        fprintf(stderr, "[jitter] judged frame %u: %s, %u draws shifted by %.4f, %.4f (scene 0x%X zeta 0x%X)\n",
+                s_scn.frame, s_scn_kind[s_scn.kind], s_jit.draws, (double)s_jit.cur[0], (double)s_jit.cur[1],
+                s_scn.last_off, s_scn.last_zeta);
+    s_jit.draws = 0;
+    FR->mv.jit[0] = s_jit.cur[0]; FR->mv.jit[1] = s_jit.cur[1]; FR->mv.jit_i = s_jit.cur_i;
+    if (s_scn.kind != SCN_SCENE) { s_jit.cur[0] = s_jit.cur[1] = 0.0f; s_jit.cur_i = 0; return; }
+    if (s_jit.fixed) {
+        const u32 k = (s_jit.phase++ / (u32)s_jit.per) % (u32)s_jit.nf;
+        if (s_jit.log && s_jit.nf > 1 && (s_jit.phase - 1) % (u32)s_jit.per == 0)
+            fprintf(stderr, "[jitter] judged frame %u: fixed offset %u (%.1f, %.1f)\n", s_scn.frame, k,
+                    (double)s_jit.fl[k][0], (double)s_jit.fl[k][1]);
+        s_jit.cur[0] = s_jit.fl[k][0]; s_jit.cur[1] = s_jit.fl[k][1]; s_jit.cur_i = k + 1;
+    }
+    else {
+        const u32 i = s_jit.phase % (u32)s_jit.n + 1;
+        s_jit.phase++;
+        s_jit.cur[0] = jit_halton(i, 2) - 0.5f; s_jit.cur[1] = jit_halton(i, 3) - 0.5f; s_jit.cur_i = i;
+    }
+    if (s_jit.log && s_jit.phase % 120 == 1)
+        fprintf(stderr, "[jitter] scene frame %u: phase %u offset %.4f, %.4f host px" "\n", s_scn.frame,
+                s_jit.cur_i, (double)s_jit.cur[0], (double)s_jit.cur[1]);
+}
+/* The clip offset (added to vp_posoffset.xy) for a draw, or 0 when it is not a scene draw. */
+static int jit_draw(const D3D12DrawRecord* dr, float out[2])
+{
+    if (!jit_on() || !dr || !s_jit.cur_i || dr->is_clear || !dr->zeta_off || !dr->vp_w || !dr->vp_h) return 0;
+    /* Colour into the scene, or anything into its depth (a depth-only pass has rt_off 0). */
+    if (dr->rt_off ? dr->rt_off != s_scn.last_off && dr->zeta_off != s_scn.last_zeta
+                   : !dr->zonly || dr->zeta_off != s_scn.last_zeta) return 0;
+    const u32 rw = dr->rt_w ? dr->rt_w : s_gw, rh = dr->rt_h ? dr->rt_h : s_gh;
+    const float hw = (float)dr->vp_w * (float)uw_host_w(rw, rh) / (float)rw;
+    const float hh = (float)dr->vp_h * (float)uw_host_h(rw, rh) / (float)rh;
+    s_jit.draws++;
+    out[0] = 2.0f * s_jit.cur[0] / hw;
+    out[1] = -2.0f * s_jit.cur[1] / hh;
+    { static int n; if (s_jit.log && n < 6 && s_jit.seen > 600) { n++;   /* a few, once a race may be up */
+        fprintf(stderr, "[jitter] draw rt 0x%X %ux%u zeta 0x%X zonly %d vp %u,%u %ux%u host %.1fx%.1f clip offset %.5f, %.5f\n",
+                dr->rt_off, dr->rt_w, dr->rt_h, dr->zeta_off, dr->zonly, dr->vp_x, dr->vp_y, dr->vp_w, dr->vp_h,
+                (double)hw, (double)hh, (double)out[0], (double)out[1]); } }
+    return 1;
 }
