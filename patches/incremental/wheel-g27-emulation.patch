+/* Custom controllers (cellPadLdd*): a game's own USB driver registers one and
+ * feeds it CellPadData; libpad hands that back on its port like any pad's.
+ * Gran Turismo 5 does this for its Logitech wheels (cellUsbd.c presents an
+ * emulated G27). They take ports from PAD_MAX_HOST_PORTS up, clear of the
+ * ports host pads land on. Adapted from gt5-recomp (MIT, (c) 2026
+ * MormonFTP-hub). */
+#ifndef CELL_PAD_ERROR_TOO_MANY_DEVICES
+#define CELL_PAD_ERROR_TOO_MANY_DEVICES 0x80121109
+#endif
+#ifndef CELL_PAD_ERROR_NO_DEVICE
+#define CELL_PAD_ERROR_NO_DEVICE 0x80121107
+#endif
+typedef struct {
+    int used;
+    u16 button[CELL_PAD_MAX_CODES];
+} PadLdd;
+static PadLdd s_ldd[CELL_PAD_MAX_PORT_NUM];
+static int    s_ldd_changed[CELL_PAD_MAX_PORT_NUM];
+static int pad_is_ldd(u32 port)
+{
+    return port < CELL_PAD_MAX_PORT_NUM && __atomic_load_n(&s_ldd[port].used, __ATOMIC_ACQUIRE);
+}
+
 static u32 pad_status_take(u32 port)
 {
+    if (port < CELL_PAD_MAX_PORT_NUM &&
+        __atomic_exchange_n(&s_ldd_changed[port], 0, __ATOMIC_RELAXED))
