+static void worker_step(unsigned long long* next_attach_us, unsigned long long* last_in_us,
+                        u8* last_report, int* have_last)
+{
+    WheelInput in;
+    const int conn = wheel_host_read(&in);
+    const unsigned long long now = usbd_now_us();
+
+    usbd_lock(&s_lock);
+    const int attached = s_attached, present = s_present, have_ldd = s_ldd_count > 0;
+    usbd_unlock(&s_lock);
+    if (conn && !present && have_ldd && now >= *next_attach_us) {
+        *next_attach_us = now + 3000000ull;   /* if it fails, try again in a while */
+        try_attach();
+        *have_last = 0;
+        return;
+    }
+    if (!conn && attached) { do_detach(); return; }
+    if (!present) return;
+
+    /* Control and OUT transfers, in order. The lock is never held across a
+     * call into the game: its callbacks queue the next transfer. */
+    for (;;) {
+        UsbdXfer x;
+        usbd_lock(&s_lock);
+        if (!s_q_n) { usbd_unlock(&s_lock); break; }
+        x = s_q[s_q_head];
+        s_q_head = (s_q_head + 1) % QCAP;
+        s_q_n--;
+        usbd_unlock(&s_lock);
+        if (x.ep == 0) {
+            s32 count = 0;
+            const s32 res = do_control(&x, &count);
+            complete(&x, res, count);
+            s_done_ctl++;
+        } else {
+            s_done_out++;
+            u8 data[64];
+            const u32 len = (u32)(x.len < 0 ? 0 : (x.len > 64 ? 64 : x.len));
+            if (x.buf && len) { vm_memcpy_from(data, x.buf, len); wheel_g27_output(data, len); }
+            complete(&x, CELL_USBD_HC_CC_NOERR, x.len);
+        }
+    }
+
+    /* IN reads: a new report as soon as it changes (2 ms apart at most, the
+     * G27's polling interval), and the same one again every 8 ms. */
+    u8 rep[USBD_REPORT_LEN];
+    wheel_g27_report(&in, rep);
+    const int changed = !*have_last || memcmp(rep, last_report, USBD_REPORT_LEN) != 0;
+    const unsigned long long since = now - *last_in_us;
+    if (!((changed && since >= 2000) || since >= 8000)) return;
+    /* The game asks for the next report once its USB thread has taken the last one's "done"
+     * event from its queue; until then it keeps the last report, the rim and pedals where they
+     * were. When that event is lost (its queue was full) it never asks again and the wheel is
+     * stuck for good, so after 1.5 s the report goes again: on a read the game had queued
+     * besides, or on the last one once more. Only one report at a time waits to be taken, so
+     * one sent again can't double the rate. Both are said in the log. */
+    static int waiting_said;
+    static unsigned waits, resends;
+    UsbdXfer x;
+    int resend = 0;
+    usbd_lock(&s_lock);
+    const int taken = !s_in_last_ok || s_in_asks != s_in_asks_at_done;
+    if (!taken || !s_in_n) {
+        if (!taken && attached && since >= 1500000) {
+            resend = 1;
+            if (s_in_n) {
+                x = s_in[0];
+                memmove(&s_in[0], &s_in[1], (size_t)(s_in_n - 1) * sizeof s_in[0]);
+                s_in_n--;
+            } else x = s_in_last;
+        }
+        usbd_unlock(&s_lock);
+        if (!resend) {
+            if (*have_last && attached && since >= 400000 && !waiting_said && waits < 20) {
+                waiting_said = 1; waits++;
+                fprintf(stderr, "[cellUsbd] the game has not asked for a wheel report for %llu ms: it keeps the last "
+                                "one (rim and pedals stuck there) until it does\n", since / 1000);
+            }
+            return;
+        }
+        if (resends++ < 20)
+            fprintf(stderr, "[cellUsbd] the game's USB thread never took the last wheel report (%llu ms): sending "
+                            "it again\n", since / 1000);
+    } else {
+        if (waiting_said) {
+            waiting_said = 0;
+            fprintf(stderr, "[cellUsbd] the game asks for wheel reports again, after %llu ms\n", since / 1000);
+        }
+        x = s_in[0];
+        memmove(&s_in[0], &s_in[1], (size_t)(s_in_n - 1) * sizeof s_in[0]);
+        s_in_n--;
+        usbd_unlock(&s_lock);
+    }
+    usbd_lock(&s_lock);
+    s_in_last = x;
+    s_in_last_ok = 1;
