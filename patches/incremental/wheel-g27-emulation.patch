+static s32 queue_xfer(s32 pipe_id, const u8* setup, u32 buf, s32 len, u32 cb, u32 arg, int want_ctrl)
+{
+    if (!s_initialized) return (s32)CELL_USBD_ERROR_NOT_INITIALIZED;
+    usbd_lock(&s_lock);
+    if (pipe_id < 0 || pipe_id >= CELL_USBD_MAX_PIPES || !s_pipe[pipe_id].used || !s_present) {
+        usbd_unlock(&s_lock);
+        return (s32)CELL_USBD_ERROR_PIPE_NOT_FOUND;
+    }
+    const UsbdPipe* p = &s_pipe[pipe_id];
+    if (want_ctrl != (p->ep == 0)) { usbd_unlock(&s_lock); return (s32)CELL_USBD_ERROR_INVALID_TRANSFER_TYPE; }
+    UsbdXfer x; memset(&x, 0, sizeof x);
+    x.pipe = pipe_id; x.ep = p->ep; x.buf = buf; x.len = len; x.cb = cb; x.arg = arg;
+    if (setup) memcpy(x.setup, setup, 8);
+    s32 rc = CELL_OK;
+    if (p->ep & 0x80) {
+        if (s_in_n < INCAP) { s_in[s_in_n++] = x; s_in_asks++; }
+        else rc = (s32)CELL_USBD_ERROR_IOREQ_NOT_ALLOCATED;
