+static void try_attach(void)
+{
+    usbd_lock(&s_lock);
+    const u32 ops = ldd_for_wheel();
+    usbd_unlock(&s_lock);
+    if (!ops || !desc_prepare()) return;
+    const u32 probe = vm_read32(ops + 4), attach = vm_read32(ops + 8);
+    static int refusals;   /* retried every few seconds: say so a few times, not forever */
