+/* ---------------------------------------------------------------------------
+ * Descriptors
+ * -------------------------------------------------------------------------*/
+static int desc_prepare(void)
+{
+    if (s_desc_ready) return 1;
+    u8 blob[128];
+    s_desc_len = wheel_g27_descriptors(blob, sizeof blob);
+    if (!s_desc_ea) s_desc_ea = ppu_alloc_scratch_stack(0x1000);
+    if (!s_desc_ea) {
+        fprintf(stderr, "[cellUsbd] no guest memory for the wheel's descriptors\n");
+        return 0;
+    }
+    vm_memcpy_to(USBD_DESC_EA, blob, s_desc_len);
+    s_desc_ready = 1;
+    return 1;
+}
+
+/* String descriptors 0 (languages), 1 (manufacturer), 2 (product). */
+static u32 string_desc(int idx, u8* out, u32 cap)
+{
+    const char* s = idx == 1 ? "Logitech" : idx == 2 ? "G27 Racing Wheel" : NULL;
+    if (idx == 0) {
+        static const u8 langs[4] = { 4, 3, 0x09, 0x04 };
+        u32 n = cap < 4 ? cap : 4;
+        memcpy(out, langs, n);
+        return n;
+    }
+    if (!s) return 0;
+    u8 d[64];
+    u32 n = 2;
+    for (const char* p = s; *p && n + 2 <= sizeof d; p++) { d[n++] = (u8)*p; d[n++] = 0; }
+    d[0] = (u8)n; d[1] = 3;
+    if (n > cap) n = cap;
+    memcpy(out, d, n);
+    return n;
+}
+
+/* ---------------------------------------------------------------------------
+ * Driver registration
+ * -------------------------------------------------------------------------*/
+static s32 add_ldd(u32 ops, u16 vid, u16 pmin, u16 pmax, int any, const char* how)
+{
+    if (!s_initialized) return (s32)CELL_USBD_ERROR_NOT_INITIALIZED;
+    if (!ops) return (s32)CELL_USBD_ERROR_INVALID_PARAM;
+    const u32 name_ea = vm_read32(ops);
+    char name[40] = "?";
+    if (name_ea) { int i = 0; for (; i < 39; i++) { name[i] = (char)vm_read8(name_ea + i); if (!name[i]) break; } name[39] = 0; }
+    if (any) printf("[cellUsbd] %s(ops=0x%08X \"%s\")\n", how, ops, name);
+    else     printf("[cellUsbd] %s(ops=0x%08X \"%s\", %04X:%04X-%04X)\n", how, ops, name, vid, pmin, pmax);
+    usbd_lock(&s_lock);
+    if (s_ldd_count >= MAX_LDD) { usbd_unlock(&s_lock); return (s32)CELL_USBD_ERROR_LDD_NOT_ALLOCATED; }
+    UsbdLdd* l = &s_ldd[s_ldd_count++];
+    l->ops = ops; l->vid = vid; l->pmin = pmin; l->pmax = pmax; l->any = any;
+    usbd_unlock(&s_lock);
+    return CELL_OK;
+}
+
+/* The driver that wants our G27, or 0. Called with the lock held. */
+static u32 ldd_for_wheel(void)
+{
+    for (int i = 0; i < s_ldd_count; i++) {
+        const UsbdLdd* l = &s_ldd[i];
+        if (l->any || (l->vid == USBD_VID && USBD_PID >= l->pmin && USBD_PID <= l->pmax))
+            return l->ops;
+    }
+    return 0;
+}
 
