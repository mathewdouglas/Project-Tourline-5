+    usbd_lock(&s_lock);
+    s_bound_ops = ops;
+    usbd_unlock(&s_lock);
+    r = attach ? (s32)ppu_guest_call(attach, USBD_DEV_ID, 0, 0, 0, 0, 0, 0, 0) : -1;
+    if (r != 0) {
