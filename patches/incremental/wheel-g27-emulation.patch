+static void complete(const UsbdXfer* x, s32 result, s32 count)
+{
+    if (!x->cb) return;
+    const unsigned long long t0 = usbd_now_us();
+    ppu_guest_call(x->cb, (uint64_t)(int64_t)result, (uint64_t)(int64_t)count, x->arg, 0, 0, 0, 0, 0);
+    /* A callback should only post an event to the driver's thread; a slow one holds up every
+     * report behind it (the wheel looks stuck in the game). */
+    const unsigned long long took = usbd_now_us() - t0;
+    static unsigned said;
+    if (took >= 100000 && said < 20) {
+        said++;
+        fprintf(stderr, "[cellUsbd] the game's %s callback took %llu ms\n",
+                x->ep == 0 ? "control" : (x->ep & 0x80) ? "report" : "force-feedback", took / 1000);
+    }
+}
 
