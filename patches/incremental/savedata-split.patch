+static void pfd_remove(const char* save_path, const char* name)
+{
+    if (!pfd_has(save_path, name)) return;
+    char path[1024], line[64];
+    pfd_path(save_path, path, sizeof(path));
+    FILE* fp = fopen(path, "rb");
+    if (!fp) return;
+    char keep[4096]; size_t n = 0;
+    while (fgets(line, sizeof(line), fp)) {
+        line[strcspn(line, "\r\n")] = 0;
+        if (!line[0] || !strcmp(line, name)) continue;
+        size_t l = strlen(line);
+        if (n + l + 2 > sizeof(keep)) break;
+        memcpy(keep + n, line, l); n += l; keep[n++] = '\n';
+    }
+    fclose(fp);
+    fp = fopen(path, "wb");
+    if (fp) { fwrite(keep, 1, n, fp); fclose(fp); }
+}
