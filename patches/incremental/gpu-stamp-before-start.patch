+/* Startup preparation before the game starts (GT5 Phase 44).
+ * RSX_SHADER_WARMUP_STARTUP=1 (F1: Preload known shaders > Before start)
+ * prepares the learned menu set, then the learned race set, on
+ * RSX_SHADER_WARMUP_THREADS helper threads (default: every logical CPU but
+ * one, 1..32) and holds the guest until they finish, like Prologue's Phase 88
+ * preload but parallel and in the learned order instead of one thread walking
+ * the whole recipe directory. The race part reads race-pack-v1.bin when it
+ * matches. Nothing is learned that the background pass would not: it is the
+ * same recipe path (pso_race_recipe), only earlier and wider. The background
+ * startup pass is not queued after it; race loading still runs its own gate.
+ * A changed GPU or driver (pso_gpu_stamp_check) runs this once even in
+ * background mode, since every learned pipeline is then cold:
+ * RSX_PSO_GPU_STAMP_PRELOAD=0 leaves that to the background pass.
+ * Progress: g_rsx_startup_prep_done/total (the "Preparing shaders" badge,
+ * src/gt5p_shaderbusy.cpp) and [shader-warmup] lines every 10%. */
+volatile LONG g_rsx_startup_prep_done, g_rsx_startup_prep_total;
+#define PSO_STARTUP_THREADS_MAX 32
+static u64 *s_sp_menu, *s_sp_race;
+static u32 s_sp_menu_n, s_sp_race_n, s_sp_n;
+static int s_sp_pack;
+static volatile LONG s_sp_next, s_sp_ready, s_sp_rejected;
+static int pso_startup_parallel_on(int* forced)
+{
+    *forced = 0;
+    const char* e = getenv("RSX_SHADER_WARMUP_STARTUP");
+    if (e && e[0] == '1') return 1;
+    pso_gpu_stamp_check();
+    const char* f = getenv("RSX_PSO_GPU_STAMP_PRELOAD");
+    if (s_gpu_changed && !(f && f[0] == '0')) { *forced = 1; return 1; }
+    return 0;
+}
+static int pso_startup_threads(void)
+{
+    const char* e = getenv("RSX_SHADER_WARMUP_THREADS");
+    int n = e ? atoi(e) : 0;
+    if (n < 1) { SYSTEM_INFO si; GetSystemInfo(&si); n = (int)si.dwNumberOfProcessors - 1; }
+    return n < 1 ? 1 : n > PSO_STARTUP_THREADS_MAX ? PSO_STARTUP_THREADS_MAX : n;
+}
+static DWORD WINAPI pso_startup_helper(LPVOID unused)
+{
+    (void)unused;
+    ps3_name_thread(L"pso-startup");
+    for (;;) {
+        if (s_pso_stopping) break;
+        const LONG i = InterlockedIncrement(&s_sp_next) - 1;
+        if (i < 0 || (u32)i >= s_sp_n) break;
+        int ok;
+        if ((u32)i < s_sp_menu_n) ok = pso_race_recipe(s_sp_menu[i]);
+        else {
+            const u32 j = (u32)i - s_sp_menu_n;
+            if (s_sp_pack) {
+                const int packed = pso_prepare_packed(&s_pack_items[j]);
+                ok = packed > 0 || (packed == 0 && pso_race_recipe(s_pack_items[j].hash));
+            } else ok = pso_race_recipe(s_sp_race[j]);
+        }
+        InterlockedIncrement(ok ? &s_sp_ready : &s_sp_rejected);
+        InterlockedIncrement(&g_rsx_startup_prep_done);
+    }
+    return 0;
+}
+/* 1 when it ran (the guest may start), 0 when there was nothing learned. */
+static int pso_startup_parallel(const char* dir, int forced)
+{
+    char menu_index[640], race_index[640];
+    snprintf(menu_index, sizeof menu_index, "%s/menu-v1.txt", dir);
+    snprintf(race_index, sizeof race_index, "%s/race-v1.txt", dir);
+    /* The worker's start-up pruning and compaction, first; the worker then skips it. */
+    pso_recipe_maintain(dir, race_index, menu_index); s_recipes_maintained = 1;
+    if (!s_sp_menu) s_sp_menu = (u64*)malloc(sizeof(u64) * PSO_RACE_SEEN);
+    if (!s_sp_race) s_sp_race = (u64*)malloc(sizeof(u64) * PSO_RACE_SEEN);
+    if (!s_sp_menu || !s_sp_race) return 0;
+    s_sp_menu_n = pso_read_hashes(menu_index, s_sp_menu, PSO_RACE_SEEN);
+    s_sp_race_n = pso_race_on() ? pso_read_hashes(race_index, s_sp_race, PSO_RACE_SEEN) : 0;
+    s_sp_pack = s_sp_race_n && pso_pack_bind(dir, race_index) && s_pack_hit && s_pack_items && s_pack_n;
+    const u32 race_n = s_sp_pack ? s_pack_n : s_sp_race_n;
+    s_sp_n = s_sp_menu_n + race_n;
+    if (!s_sp_n) {
+        fprintf(stderr, "[shader-warmup] before start: nothing learned yet; this run will learn the sets\n");
+        if (s_sp_pack) pso_pack_release();
+        s_sp_pack = 0;
+        return 0;
+    }
+    int n = pso_startup_threads();
+    if ((u32)n > s_sp_n) n = (int)s_sp_n;
+    s_sp_next = s_sp_ready = s_sp_rejected = 0;
+    InterlockedExchange(&g_rsx_startup_prep_done, 0);
+    InterlockedExchange(&g_rsx_startup_prep_total, (LONG)s_sp_n);
+    fprintf(stderr, "[shader-warmup] before start%s: preparing %u menu + %u race pipelines (%s) on %d threads; guest waits\n",
+            forced ? " (GPU or driver changed)" : "", s_sp_menu_n, race_n, s_sp_pack ? "race pack" : "files", n);
+    const ULONGLONG began = GetTickCount64();
+    InterlockedIncrement(shader_busy_ctr(1));
+    HANDLE thr[PSO_STARTUP_THREADS_MAX]; int started = 0;
+    for (int i = 0; i < n; i++) {
+        HANDLE t = CreateThread(NULL, 0, pso_startup_helper, NULL, 0, NULL);
+        if (t) thr[started++] = t;
+    }
+    if (!started) pso_startup_helper(NULL);
+    LONG last_tenth = 0;
+    for (int i = 0; i < started; i++) {
+        while (WaitForSingleObject(thr[i], 250) == WAIT_TIMEOUT) {
+            const LONG tenth = (LONG)((long long)g_rsx_startup_prep_done * 10 / (long long)s_sp_n);
+            if (tenth > last_tenth) {
+                last_tenth = tenth;
+                fprintf(stderr, "[shader-warmup] before start: %ld/%u (%ld%%, %llu ms)\n", (long)g_rsx_startup_prep_done, s_sp_n,
+                        tenth * 10, (unsigned long long)(GetTickCount64() - began));
+            }
+        }
+        CloseHandle(thr[i]);
+    }
+    InterlockedDecrement(shader_busy_ctr(1));
+    fprintf(stderr, "[shader-warmup] before start finished: ready=%ld rejected=%ld of %u, elapsed_ms=%llu, threads=%d (%s); "
+                    "unseen variants may still compile\n", (long)s_sp_ready, (long)s_sp_rejected, s_sp_n,
+            (unsigned long long)(GetTickCount64() - began), started ? started : 1, s_sp_pack ? "race pack" : "files");
+    pso_prep_split_print();
+    s_pso_warm_loaded += (u32)s_sp_ready; s_pso_warm_rejected += (u32)s_sp_rejected;
+    /* Everything the pack held is resident now; race loading binds it again. */
+    if (s_sp_pack) pso_pack_release();
+    s_sp_pack = 0;
+    InterlockedExchange(&g_rsx_startup_prep_total, 0);
+    return 1;
+}
