+/* GPU and driver stamp (GT5 Phase 44). A driver pipeline blob only serves the
+ * GPU and driver that wrote it; after a driver update the driver refuses every
+ * one, each after a file read, and the pipeline is built again anyway.
+ * <cache>/gpu-stamp.txt holds the stamp (pso_gpu_stamp_set) and since=, the
+ * time this stamp was first seen (Unix seconds). Blob files and the race pack
+ * written before since= are left unread: they are rebuilt and replaced as
+ * before, without the wasted read. A changed stamp also runs the startup
+ * preparation before the game starts this once (see pso_startup_parallel_on),
+ * because every learned pipeline is cold for the new driver.
+ * A stamp file that does not exist yet is written with since=0: blobs of an
+ * older build are of unknown origin and the driver still judges them.
+ * RSX_PSO_GPU_STAMP=0: no stamp, no skipping (the driver alone decides).
+ * s_gpu_stamp is declared again here (a tentative definition of the same
+ * object) so the WARP tests that compile this part alone have it. */
+static char s_gpu_stamp[400];
+static u64 s_blob_since;                /* 0: read every blob */
+static int s_gpu_changed;
+static char s_gpu_stamp_old[400];
+static volatile LONG s_blob_stale;       /* blob files skipped as older than the driver */
+static u64 filetime_unix(const FILETIME* ft)
+{
+    const u64 t = ((u64)ft->dwHighDateTime << 32) | ft->dwLowDateTime;
+    return t > 116444736000000000ull ? (t - 116444736000000000ull) / 10000000ull : 0;
+}
+static BOOL CALLBACK pso_gpu_stamp_init(PINIT_ONCE once, PVOID param, PVOID* context)
+{
+    (void)once; (void)param; (void)context;
+    const char* e = getenv("RSX_PSO_GPU_STAMP");
+    const char* dir = shader_cache_dir();
+    if ((e && e[0] == '0') || !s_gpu_stamp[0] || !dir || !strcmp(dir, "0")) return TRUE;
+    char path[512]; snprintf(path, sizeof path, "%s/gpu-stamp.txt", dir);
+    char line[512]; char old[400] = ""; unsigned long long since = 0; int have = 0;
+    FILE* f = fopen(path, "r");
+    if (f) {
+        while (fgets(line, sizeof line, f)) {
+            line[strcspn(line, "\r\n")] = 0;
+            if (!strncmp(line, "stamp=", 6)) { snprintf(old, sizeof old, "%s", line + 6); have = 1; }
+            else if (!strncmp(line, "since=", 6)) since = strtoull(line + 6, NULL, 10);
+        }
+        fclose(f);
+    }
+    if (have && !strcmp(old, s_gpu_stamp)) { s_blob_since = (u64)since; return TRUE; }
+    if (have) {
+        FILETIME now; GetSystemTimeAsFileTime(&now); since = (unsigned long long)filetime_unix(&now);
+        s_gpu_changed = 1;
+        snprintf(s_gpu_stamp_old, sizeof s_gpu_stamp_old, "%s", old);
+        fprintf(stderr, "[pso-stamp] GPU or driver changed since the pipelines were saved (was: %s; now: %s): "
+                        "older driver pipeline files are rebuilt without being read\n", old, s_gpu_stamp);
+        s_blob_since = (u64)since;
+    } else {
+        since = 0;
+        fprintf(stderr, "[pso-stamp] recorded %s\n", s_gpu_stamp);
+    }
+    char tmp[540]; snprintf(tmp, sizeof tmp, "%s.%lu.tmp", path, (unsigned long)GetCurrentThreadId());
+    f = fopen(tmp, "w");
+    if (f) {
+        int ok = fprintf(f, "stamp=%s\nsince=%llu\n", s_gpu_stamp, since) > 0;
+        ok = !fclose(f) && ok;
+        if (!ok || !MoveFileExA(tmp, path, MOVEFILE_REPLACE_EXISTING)) DeleteFileA(tmp);
+    }
+    return TRUE;
+}
+static void pso_gpu_stamp_check(void)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    if (!s_d3d.device) return;
+    InitOnceExecuteOnce(&once, pso_gpu_stamp_init, NULL, NULL);
+}
+/* A file last written before this driver was first seen. Costs one attribute
+ * query, and only once a driver change has been recorded (since= is 0 until
+ * then). A file that cannot be queried is left to the normal read. */
+static int pso_file_predates_driver(const char* path)
+{
+    pso_gpu_stamp_check();
+    if (!s_blob_since) return 0;
+    WIN32_FILE_ATTRIBUTE_DATA a;
+    return GetFileAttributesExA(path, GetFileExInfoStandard, &a) && filetime_unix(&a.ftLastWriteTime) < s_blob_since;
+}
