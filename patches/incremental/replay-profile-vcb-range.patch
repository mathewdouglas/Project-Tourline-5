+            s_rp_runs[0] / frames, s_rp_run_draws[0] / frames, s_rp_runs[1] / frames, s_rp_run_draws[1] / frames,
+            s_rp_runs[2] / frames, s_rp_run_draws[2] / frames, s_rp_runs[3] / frames, s_rp_run_draws[3] / frames,
+            s_rp_runs[4] / frames, s_rp_run_draws[4] / frames, s_rp_runs[5] / frames, s_rp_run_draws[5] / frames, 10);
+    memset(s_rp, 0, sizeof s_rp); memset(s_rp_runs, 0, sizeof s_rp_runs); memset(s_rp_run_draws, 0, sizeof s_rp_run_draws);
