+/* RSX_VCB_RANGE=1 (off by default until measured): a draw copies into its
+ * constant slot only the vertex-constant registers its program can read,
+ * instead of the whole 8 KB bank. Most of a race frame's ~3,000 draws change
+ * the bank (each car part has its own matrices), so the full copy was 8 KB of
+ * upload-heap writes per draw. Exact: the registers left out of a slot are
+ * never read by that slot's program, and a later draw reuses the slot only
+ * when its own range lies inside the one copied. Programs with relative
+ * addressing (vp_c[(n + a0.x) & 511u]) copy the whole bank. The capture and
+ * constant diagnostics (RSX_CAP*, VP_MVP, RSX_DBG_CB, RSX_VCB_DBG) read whole
+ * slots, so they turn it off. */
+static int vcb_range_on(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char* e = getenv("RSX_VCB_RANGE");
+        on = e && e[0] == '1' && !getenv("RSX_CAP") && !getenv("RSX_CAP_VPC") && !getenv("VP_MVP") &&
+             !getenv("RSX_DBG_CB") && !getenv("RSX_VCB_DBG") && !getenv("VP_FIXPROJ");
+    }
+    return on;
+}
+/* The literal constant registers a decompiled vertex program's HLSL reads.
+ * The decompiler writes a constant operand as vp_c[<n>] or, with the address
+ * register, vp_c[(<n>u + a<i>.<c>) & 511u] (rsx_vp_decompiler.c); the
+ * declaration "float4 vp_c[512];" is skipped. Anything else, and any relative
+ * read, leaves *known 0 (the whole bank). */
+static void vp_hlsl_const_range(const char* hlsl, u16* lo, u16* hi, u8* known)
+{
+    unsigned l = RSX_MAX_VERTEX_CONSTANTS, h = 0;
+    *lo = 0; *hi = RSX_MAX_VERTEX_CONSTANTS; *known = 0;
+    if (!hlsl) return;
+    for (const char* p = strstr(hlsl, "vp_c["); p; p = strstr(p + 5, "vp_c[")) {
+        if (p - hlsl >= 7 && !strncmp(p - 7, "float4 ", 7)) continue;   /* the declaration */
+        const char* q = p + 5;
+        if (*q < '0' || *q > '9') return;                                 /* relative */
+        unsigned v = 0;
+        while (*q >= '0' && *q <= '9') { v = v * 10u + (unsigned)(*q - '0'); if (v > 4096u) return; q++; }
+        if (*q != ']') return;
+        if (v >= RSX_MAX_VERTEX_CONSTANTS) return;
+        if (v < l) l = v;
+        if (v + 1u > h) h = v + 1u;
+    }
+    if (h == 0) l = 0;                    /* reads no constant: an empty range */
+    *lo = (u16)l; *hi = (u16)h; *known = 1;
+}
