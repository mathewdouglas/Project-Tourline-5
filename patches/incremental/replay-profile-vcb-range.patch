+/* RSX_REPLAYPROF=1: every 5 s, the replay thread's draw loop split by stage,
+ * in ms per frame, beside RSX_DRAWPROF's split of recording. Stages follow
+ * the loop in order: target (retargeting and depth ownership), pipeline
+ * (pipeline lookup and SetPipelineState), state (stencil, blend colour,
+ * viewport, scissor), textures (snapshots, resolves and transitions before
+ * binding), bind (descriptor table, constants, vertex and index views),
+ * draw (the Draw call) and rest (whatever follows a draw, and draws left
+ * out). Also counted: draws issued, pipeline changes, target switches, and
+ * how many issued draws in a row share a pipeline -- the runs an
+ * ExecuteIndirect batch could cover. Timed with the TSC on the replay
+ * thread only; unset, each probe is one predictable branch. */
+enum { RP_TARGET, RP_PSO, RP_STATE, RP_TEX, RP_BIND, RP_DRAW, RP_REST, RP_N };
+static const char* const s_rp_name[RP_N] = { "target", "pipeline", "state", "textures", "bind", "draw", "rest" };
+static unsigned long long s_rp[RP_N];
+static unsigned s_rp_draws, s_rp_pso_changes, s_rp_rt_switches;
+static unsigned s_rp_runs[6];        /* same-pipeline runs: 1, 2-3, 4-7, 8-15, 16-63, 64+ */
+static unsigned long long s_rp_run_draws[6];
+static int rp_on(void)
+{
+    static int v = -1;
+    if (v < 0) v = getenv("RSX_REPLAYPROF") ? 1 : 0;
+    return v;
+}
+#define RP_LAP(k, t) do { if (rp_on()) { const unsigned long long _n = __rdtsc(); s_rp[k] += _n - (t); (t) = _n; } } while (0)
+static void rp_run_end(unsigned run)
+{
+    if (!run) return;
+    const int b = run == 1 ? 0 : run < 4 ? 1 : run < 8 ? 2 : run < 16 ? 3 : run < 64 ? 4 : 5;
+    s_rp_runs[b]++; s_rp_run_draws[b] += run;
+}
+static void rp_report(void)
+{
+    static ULONGLONG t0; static unsigned long long tsc0, f0; static LARGE_INTEGER q0;
+    const ULONGLONG now = GetTickCount64();
+    if (!t0) { t0 = now; tsc0 = __rdtsc(); QueryPerformanceCounter(&q0); f0 = s_d3d.frame_count; return; }
+    if (now - t0 < 5000) return;
+    LARGE_INTEGER q, f; QueryPerformanceCounter(&q); QueryPerformanceFrequency(&f);
+    const unsigned long long tsc = __rdtsc();
+    const double tsc_per_ms = (double)(tsc - tsc0) / ((double)(q.QuadPart - q0.QuadPart) * 1000.0 / (double)f.QuadPart);
+    const double frames = (double)(s_d3d.frame_count - f0) > 0 ? (double)(s_d3d.frame_count - f0) : 1.0;
+    double total = 0;
+    for (int k = 0; k < RP_N; k++) total += (double)s_rp[k];
+    fprintf(stderr, "[replayprof] %.0f frames: total %.2f ms", frames, total / tsc_per_ms / frames);
+    for (int k = 0; k < RP_N; k++) fprintf(stderr, " %s %.2f", s_rp_name[k], (double)s_rp[k] / tsc_per_ms / frames);
+    fprintf(stderr, " | per frame: %.0f draws, %.0f pipeline changes, %.0f target switches | same-pipeline runs"
+                    " (runs/draws per frame) 1: %.0f/%.0f 2-3: %.0f/%.0f 4-7: %.0f/%.0f 8-15: %.0f/%.0f 16-63: %.0f/%.0f 64+: %.0f/%.0f%c",
