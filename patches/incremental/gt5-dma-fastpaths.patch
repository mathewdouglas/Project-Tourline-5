+/* DMA/channel fast paths, adapted from Ascension-R (MIT), 2c521988.
+ * Startup environment is cached, as with the individual probes below.
+ * SPU_DMA_FAST=0 restores diagnostic dispatch and engine lookups for A/B.
+ * Cache lines are isolated from write-heavy counters. Atomic publication
+ * permits several SPU workers to initialize the same immutable options. */
+#if defined(_MSC_VER)
+#define SPU_DMA_CACHELINE __declspec(align(64))
+#else
+#define SPU_DMA_CACHELINE __attribute__((aligned(64)))
+#endif
+static inline int spu_dma_fast(void)
+{
+    static SPU_DMA_CACHELINE struct { int value; char pad[60]; } cache = { -1, { 0 } };
+    int value = __atomic_load_n(&cache.value, __ATOMIC_ACQUIRE);
+    if (value < 0) {
+        const char* e = getenv("SPU_DMA_FAST");
+        value = !(e && *e == '0');
+        __atomic_store_n(&cache.value, value, __ATOMIC_RELEASE);
+    }
+    return value;
+}
+
+/* Only blocks which are inert without an environment variable use this gate.
+ * When adding a gated probe, add its enabling variable here too. Presence,
+ * including an empty value or "0", enters the original block so that its
+ * original parsing decides. SPU_DMA_DIAG forces all original probe checks.
+ * SPU_DMA_RANGE_HIST works independently of SPU_DMA_RANGE; keep both. */
+static inline int spu_dma_diag(void)
+{
+    static SPU_DMA_CACHELINE struct { int value; char pad[60]; } cache = { -1, { 0 } };
+    int value = __atomic_load_n(&cache.value, __ATOMIC_ACQUIRE);
+    if (value < 0) {
+        static const char* const names[] = {
+            "SPU_DMA_DIAG", "SPU_DMA_WATCH", "SPU_DMA_RANGE", "SPU_DMA_RANGE_HIST",
+            "SPU_JOBDESC", "SPU_SPINDBG", "SPU_DMACHK", "SPU_GETHIST",
+            "SPU_PUTHIST", "SPU_MFC_TRACE", "SPU_STACKEA_WATCH", "SPU_DMATRACE_ALL",
+            "SPU_DUMP_GET", "SPU_OVL_DIAG", "SPU_SMC_WATCH", "SPU_LS_WATCH",
+            "SPU_PUTVAL", "SPU_CMDHIST", "SPU_WATCHEA", "SPU_WATCHLSA",
+            "SPU_ROWCOV", "SPU_VRAMPC", "SPU_H2LSRC", "SPU_PUTEA",
+            "SPU_DMATRACE", "SPU_DMATRACE_RAW", "SPU_TAGPROBE"
+        };
+        value = !spu_dma_fast();
+        for (unsigned i = 0; !value && i < sizeof names / sizeof names[0]; i++)
+            if (getenv(names[i])) value = 1;
+        __atomic_store_n(&cache.value, value, __ATOMIC_RELEASE);
+    }
+    return value;
+}
+
+/* These channel writes only latch context fields. No engine is needed until
+ * a command, tag update, or list acknowledgement actually consumes it. */
+static inline int mfc_context_write(spu_context* spu, uint32_t channel, uint32_t value)
+{
+    switch (channel) {
+    case MFC_LSA:       spu->mfc_lsa = value; return 1;
+    case MFC_EAH:       spu->mfc_eah = value; return 1;
+    case MFC_EAL:       spu->mfc_eal = value; return 1;
+    case MFC_Size:      spu->mfc_size = value; return 1;
+    case MFC_TagID:     spu->mfc_tag = value & 0x1F; return 1;
+    case MFC_WrTagMask: spu->mfc_tag_mask = value; return 1;
+    default:           return 0;
+    }
+}
