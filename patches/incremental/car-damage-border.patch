+/* BORDER addressing (RSX wrap mode 4, and 7 = mirror once to border): a
+ * coordinate outside 0..1 on that axis reads the unit's border colour. The
+ * sampler bank has only wrap and clamp, so clamp stretched the texture's edge
+ * texels outward. GT5 scratches each car's paint map with a border-addressed
+ * scratch texture at every impact; clamped, the edges became long streaks over
+ * whole panels that built up with every hit (#42/#47). Every Sample-family
+ * call of unit `u` becomes rsx_bd<u>(call, coords); run after the texel-scale
+ * rewrites so the coordinates tested are normalized. Only units whose format
+ * asks for the border colour (SET_TEXTURE_FORMAT bit 3); a border texture
+ * (bit 3 clear) keeps its own edge texels. RSX_TEX_BORDER_ADDR=0: old. */
+static int fp_border_unit(char* hlsl, size_t cap, int u)
+{
+    char needles[2][32], pre[16];
+    int patched = 0;
+    snprintf(needles[0], sizeof needles[0], "rsx_tex[%d].Sample", u);
+    snprintf(needles[1], sizeof needles[1], "rsx_tex%d.Sample", u);
+    snprintf(pre, sizeof pre, "rsx_bd%d(", u);
+    const size_t pl = strlen(pre);
+    for (int ni = 0; ni < 2; ni++) {
+        for (;;) {
+            char* at = strstr(hlsl, needles[ni]);
+            if (!at) break;
+            memcpy(at, "rsx_TEX", 7);                 /* visited */
+            const char* name = at + strlen(needles[ni]);
+            /* Sample, SampleLevel, SampleBias, SampleGrad: coordinates are the
+             * second argument. Not SampleCmp (shadow units). */
+            if (!strncmp(name, "Cmp", 3)) continue;
+            char* p = strchr(at, '(');
+            if (!p) break;
+            int depth = 0, commas = 0; char *c1 = NULL, *c2 = NULL, *end = NULL;
+            for (; *p; p++) {
+                if (*p == '(' || *p == '[') depth++;
+                else if (*p == ')' || *p == ']') { depth--; if (!depth) { end = p; break; } }
+                else if (*p == ',' && depth == 1) { if (++commas == 1) c1 = p; else if (commas == 2) c2 = p; }
+            }
+            if (!end || !c1) continue;
+            const char* ce = c2 ? c2 : end;
+            const size_t cl = (size_t)(ce - (c1 + 1));
+            /* call -> pre call, (coords)) */
+            const size_t ins = 3 + cl + 2;
+            const size_t used = strlen(hlsl);
+            if (used + pl + ins + 1 > cap) return -1;
+            char coords[1024];
+            if (cl >= sizeof coords) continue;
+            memcpy(coords, c1 + 1, cl); coords[cl] = 0;
+            const size_t tail_at = (size_t)(end + 1 - hlsl);
+            memmove(hlsl + tail_at + ins, hlsl + tail_at, used - tail_at + 1);
+            memcpy(hlsl + tail_at, ", (", 3);
+            memcpy(hlsl + tail_at + 3, coords, cl);
+            memcpy(hlsl + tail_at + 3 + cl, "))", 2);
+            memmove(at + pl, at, strlen(at) + 1);
+            memcpy(at, pre, pl);
+            patched++;
+        }
+    }
+    for (char* q = hlsl; (q = strstr(q, "rsx_TEX")) != NULL; ) memcpy(q, "rsx_tex", 7);
+    return patched;
+}
+static int tex_border_on(void)
