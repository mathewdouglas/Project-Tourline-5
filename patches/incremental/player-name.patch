diff --git a/libs/system/cellSysutil.c b/libs/system/cellSysutil.c
index 44761ae..0f9833a 100644
--- a/libs/system/cellSysutil.c
+++ b/libs/system/cellSysutil.c
@@ -325,7 +325,9 @@ s32 cellSysutilGetSystemParamString(s32 id, u32 buf_ea, u32 bufsize)
         break;
     }
     case CELL_SYSUTIL_SYSTEMPARAM_ID_CURRENT_USERNAME: {
-        const char* s = "User";
+        /* PS3_USER_NAME: the player's own (the port's game.player_name). */
