-# Lifter
-# ---------------------------------------------------------------------------
-
-@dataclass
-class LiftedFunction:
-    name: str = ""
-    start_addr: int = 0
-    end_addr: int = 0
-    body_lines: list[str] = field(default_factory=list)
-    calls: list[int] = field(default_factory=list)
-
