diff --git a/tools/spu_regcache_lazy.py b/tools/spu_regcache_lazy.py
new file mode 100644
--- /dev/null
+++ b/tools/spu_regcache_lazy.py
@@ -0,0 +1,110 @@
+"""Lazy SPU register locals; control-flow approach informed by gt5-recomp 1590f03.
+
+Unlike the eager cache, this loads on first use and invalidates after calls.
+Context-visible exits/calls still publish dirty registers. Internal branch
+edges reconcile locals explicitly, retaining loop-carried values.
+"""
+import re
+
+GPR = re.compile(r'ctx->gpr\[(\d+)\]')
+SET = re.compile(r'ctx->gpr\[(\d+)\]\s*=(?!=)')
+MARK = re.compile(r'(/\*@[XOI]\*/)|(goto loc_[0-9A-F]{8};)')
+
+
+def localize(lines, cache_ls=False):
+    ls_used=cache_ls and any('spu_ls_read128(ctx,' in l or 'spu_ls_write128(ctx,' in l for l in lines)
+    if ls_used:
+        lines=[l.replace('spu_ls_read128(ctx,','spu_codegen_lq(_cg_ls,').replace('spu_ls_write128(ctx,','spu_codegen_sq(_cg_ls,') for l in lines]
+    used, written, gotos = set(), set(), {}
+    for i, line in enumerate(lines):
+        used.update(map(int, GPR.findall(line)))
+        written.update(map(int, SET.findall(line)))
+        for target in re.findall(r'goto (loc_[0-9A-F]{8});', line):
+            gotos.setdefault(target, []).append(i)
+    labels = {line.strip()[:-1]: i for i, line in enumerate(lines)
+              if re.fullmatch(r'loc_[0-9A-F]{8}:', line.strip())}
+    loops = {}
+    for target, sites in gotos.items():
+        if target not in labels:
+            raise ValueError(f'unresolved register-cache edge {target}')
+        head = labels[target]
+        back = [site for site in sites if site >= head]
+        if back:
+            loops[target] = {int(n) for line in lines[head:max(back)+1] for n in GPR.findall(line)}
+
+    def stores(regs):
+        return ''.join(f'ctx->gpr[{n}] = r{n}; ' for n in sorted(regs))
+
+    def loads(regs):
+        return ''.join(f'r{n} = ctx->gpr[{n}]; ' for n in sorted(regs))
+
+    out = ['    u128 ' + ', '.join(f'r{n}' for n in sorted(used)) + ';'] if used else []
+    if ls_used: out.insert(0,'    uint8_t* _cg_ls = ctx->ls;')
+    available, dirty = set(), set()
+    incoming, forward, edges = {}, {}, {}
+    falls = True
+    for line in lines:
+        label = line.strip()
+        if re.fullmatch(r'loc_[0-9A-F]{8}:', label):
+            name = label[:-1]
+            states = [a for _, a, _ in forward.get(name, [])]
+            if falls:
+                states.append(available)
+            common = set.intersection(*states) if states else set()
+            if name in loops:
+                common &= loops[name]
+            for key, a, d in forward.get(name, []):
+                edges[key] = stores(d - common)
+            if falls and dirty - common:
+                out.append('    ' + stores(dirty - common))
+            available, dirty = set(common), common & written
+            incoming[name] = frozenset(common)
+            out.append(line)
+            falls = True
+            continue
+        # Loads must precede the line, so conditions and RHS values see the
+        # incoming state (including instructions whose destination is a source).
+        assignments = {m.start() for m in SET.finditer(line)}
+        reads = {int(m.group(1)) for m in GPR.finditer(line) if m.start() not in assignments}
+        # Current lifter only emits writes after @I (channel result). Reject a
+        # future shape that would require a load at a different scope/position.
+        reload_at = line.find('/*@I*/')
+        if reload_at >= 0:
+            tail = line[reload_at:]
+            targets = {m.start() for m in SET.finditer(tail)}
+            if any(m.start() not in targets for m in GPR.finditer(tail)):
+                raise ValueError('register read after runtime reload: ' + line)
+        pre = loads(reads - available)
+        available |= reads
+        parts = MARK.split(line)
+        result = []
+        for i in range(0, len(parts), 3):
+            text = parts[i]
+            writes = set(map(int, SET.findall(text)))
+            available |= writes
+            dirty |= writes
+            result.append(GPR.sub(lambda m: 'r'+m.group(1), text))
+            if i+1 >= len(parts):
+                break
+            mark, jump = parts[i+1:i+3]
+            if mark == '/*@X*/':
+                result.append(stores(dirty))
+            elif mark == '/*@O*/':
+                result.append(stores(dirty))
+                dirty = set()
+            elif mark == '/*@I*/':
+                if ls_used: result.append('_cg_ls = ctx->ls; ')
+                available, dirty = set(), set()
+            elif jump:
+                target = jump[len('goto '):-1]
+                if target in incoming:
+                    held = incoming[target]
+                    code = stores(dirty-held) + loads(held-available)
+                else:
+                    code = f'@EDGE{sum(map(len, forward.values()))}@'
+                    forward.setdefault(target, []).append((code,set(available),set(dirty)))
+                result.append('{ '+code+jump+' }')
+        body = ''.join(result)
+        out.append(body[:len(body)-len(body.lstrip())]+pre+body.lstrip() if pre else body)
+        falls = not re.fullmatch(r'\s*goto loc_[0-9A-F]{8};\s*', line)
+    return [re.sub(r'@EDGE\d+@',lambda m: edges[m.group()], line) for line in out]
