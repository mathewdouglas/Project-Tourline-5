diff --git a/runtime/spu/spu_job_fingerprint.h b/runtime/spu/spu_job_fingerprint.h
new file mode 100644
--- /dev/null
+++ b/runtime/spu/spu_job_fingerprint.h
@@ -0,0 +1,76 @@
+/* Per-worker job fingerprint memo. Sparse validation retains the existing
+ * dispatch policy; SPU_JOB_FP_VERIFY=1 measures missed in-place mutations.
+ * Thread-local ownership avoids racing entries between job-chain walkers. */
+#ifndef SPU_JOB_FINGERPRINT_H
+#define SPU_JOB_FINGERPRINT_H
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#ifndef SPU_JOB_FP_HASH
+#define SPU_JOB_FP_HASH spu_workload_fingerprint
+#endif
+#if defined(_MSC_VER)
+#define SPU_JOB_FP_TLS __declspec(thread)
+#else
+#define SPU_JOB_FP_TLS _Thread_local
+#endif
+
+static uint64_t spu_job_fingerprint(const uint8_t* image, uint32_t size)
+{
+    enum { MAX_SLOTS = 256 };
+    static SPU_JOB_FP_TLS struct {
+        struct { const uint8_t* p; uint32_t n; uint64_t chk, fp; } memo[MAX_SLOTS];
+        unsigned slots, next;
+        int stats, verify;
+        const char* trace;
+        unsigned long long calls, hits, misses, hashed_bytes, stale;
+    } c;
+    if (!c.slots) {
+        const char* s = getenv("SPU_JOB_FP_SLOTS");
+        int n = s ? atoi(s) : 16;
+        c.slots = n > 0 && n <= MAX_SLOTS ? (unsigned)n : 16u;
+        c.stats = getenv("SPU_JOB_FP_STATS") && atoi(getenv("SPU_JOB_FP_STATS"));
+        c.verify = getenv("SPU_JOB_FP_VERIFY") && atoi(getenv("SPU_JOB_FP_VERIFY"));
+        c.trace = getenv("SPU_JOB_FP_TRACE");
+    }
+    uint64_t chk = 1469598103934665603ULL, fp = 0;
+    for (uint32_t i = 0; i < size && i < 256; i += 8) { chk ^= image[i]; chk *= 1099511628211ULL; }
+    for (uint32_t i = 256; i < size; i += 2039) { chk ^= image[i]; chk *= 1099511628211ULL; }
+    unsigned k;
+    for (k = 0; k < c.slots; k++)
+        if (c.memo[k].p == image && c.memo[k].n == size && c.memo[k].chk == chk) break;
+    c.calls++;
+    if (k < c.slots) {
+        c.hits++;
+        fp = c.memo[k].fp;
+        if (c.verify) {
+            uint64_t actual = SPU_JOB_FP_HASH(image, size);
+            c.hashed_bytes += size;
+            if (actual != fp) { c.stale++; c.memo[k].fp = fp = actual; }
+        }
+    } else {
+        c.misses++;
+        fp = SPU_JOB_FP_HASH(image, size);
+        c.hashed_bytes += size;
+        k = c.next++ % c.slots;
+        c.memo[k].p = image; c.memo[k].n = size;
+        c.memo[k].chk = chk; c.memo[k].fp = fp;
+    }
+    /* Trace is deliberately diagnostic-only. One append per dispatch, so it
+     * can perturb timings; replay it offline instead of quoting trace-run FPS. */
+    if (c.trace && *c.trace) {
+        FILE* f = fopen(c.trace, "a");
+        if (f) {
+            fprintf(f, "%p %p %u %016llX %016llX\n", (void*)&c, (const void*)image,
+                    size, (unsigned long long)chk, (unsigned long long)fp);
+            fclose(f);
+        }
+    }
+    if (c.stats && !(c.calls & 16383u))
+        fprintf(stderr, "[spu-job-fp] worker=%p slots=%u calls=%llu hits=%llu misses=%llu hashed_bytes=%llu stale=%llu\n",
+                (void*)&c, c.slots, c.calls, c.hits, c.misses, c.hashed_bytes, c.stale);
+    return fp;
+}
+#endif
diff --git a/runtime/spu/spu_codegen_ls.h b/runtime/spu/spu_codegen_ls.h
new file mode 100644
--- /dev/null
+++ b/runtime/spu/spu_codegen_ls.h
@@ -0,0 +1,30 @@
+/* LS access with an explicit base, for optional lazy-locals experiments.
+ * Same alignment, mask and endian conversion as the production accessors.
+ * Register-reading diagnostics require the original, uncached source. */
+#ifndef SPU_CODEGEN_LS_H
+#define SPU_CODEGEN_LS_H
+#ifdef SPU_LS_NO_PROBES
+static inline u128 spu_codegen_lq(const uint8_t* ls,uint32_t addr) {
+    u128 r; const uint8_t* p=ls+(addr&(SPU_LS_MASK&~15u));
+    for(int i=0;i<4;i++) {
+        uint32_t w;memcpy(&w,p+4*i,4);
+#if SPU_LS_FAST
+        r._u32[i]=SPU_BSWAP32(w);
+#else
+        r._u32[i]=((uint32_t)p[4*i]<<24)|((uint32_t)p[4*i+1]<<16)|((uint32_t)p[4*i+2]<<8)|p[4*i+3];
+#endif
+    }
+    return r;
+}
+static inline void spu_codegen_sq(uint8_t* ls,uint32_t addr,u128 value) {
+    uint8_t* p=ls+(addr&(SPU_LS_MASK&~15u));
+    for(int i=0;i<4;i++) {
+#if SPU_LS_FAST
+        uint32_t w=SPU_BSWAP32(value._u32[i]);memcpy(p+4*i,&w,4);
+#else
+        uint32_t w=value._u32[i];p[4*i]=(uint8_t)(w>>24);p[4*i+1]=(uint8_t)(w>>16);p[4*i+2]=(uint8_t)(w>>8);p[4*i+3]=(uint8_t)w;
+#endif
+    }
+}
+#endif
+#endif
