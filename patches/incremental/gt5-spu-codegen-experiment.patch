-            c = self._translate(insn, func)
-            if c:
-                if self.trace:
-                    func.body_lines.append(f"    spu_trace_pc(ctx, 0x{insn.addr:X});")
-                func.body_lines.append(f"    {c}")
-                if self.trace and insn.mnemonic not in _NO_RT_WRITE:
-                    rt_idx = insn.raw & 0x7F
-                    func.body_lines.append(f"    spu_trace_rt(ctx, {rt_idx});")
-            last_insn = insn
-
-        # Fall-through chaining: if the final instruction does NOT unconditionally
-        # end the basic block (i.e. it's a normal op, a call brsl/bisl, or a
-        # conditional branch whose not-taken path continues), execution proceeds
-        # into the next sequential function. Emit a tail-call so the chain isn't
-        # truncated (this was silently dropping execution mid-job).
-        _TERMINATORS = {"br", "bra", "bi", "iret", "stop", "stopd"}
-        if (last_insn is not None and last_insn.mnemonic not in _TERMINATORS
-                and end in getattr(self, "func_starts", set())):
-            func.body_lines.append(
-                f"    {{ {_RC_EXIT}ctx->pc = 0x{end:X}; "
-                f"g_spu_trampoline_fn = {self.prefix}spu_func_{end:08X}; return; }}")
-
-        # Infinite no-op self-loop (the SPU `br .` halt idiom): a function whose
-        # whole body is nops + an unconditional branch back into itself does
-        # nothing but spin. The default lifting renders it as `goto loc_<x>` --
-        # an infinite C loop that hangs the SPU host thread forever (e.g. the
-        # SPURS task runtime's terminal/idle state). Render it as a clean abort
-        # (spu_halt longjmps back to the dispatcher) so the host thread returns.
-        body_insns = [i for i in insns if start <= i.addr < end]
-        if body_insns and all(i.mnemonic in ("nop", "lnop", "br", "bra")
-                              for i in body_insns):
-            last = body_insns[-1]
-            ltgt = self._branch_target(last)
-            if (last.mnemonic in ("br", "bra") and ltgt is not None
-                    and start <= ltgt < end):
-                func.body_lines = [
-                    "    /* infinite no-op self-loop (SPU halt idiom) -> abort */",
-                    "    spu_halt(ctx); return;",
-                ]
-
-        if self.regcache:
-            # Falling off the end returns to the dispatcher like any exit.
-            func.body_lines.append(f"    {_RC_EXIT};")
-            self._apply_regcache(func)
-        else:
-            func.body_lines = [_RC_MARK.sub("", b) for b in func.body_lines]
-        self.functions.append(func)
-        return func
-
-    @staticmethod
-    def _apply_regcache(func: LiftedFunction) -> None:
-        """Move the function's guest registers into locals; see _RC_EXIT."""
-        body = func.body_lines
-        used = sorted({int(n) for b in body for n in _RC_GPR.findall(b)})
-        if not used:
-            func.body_lines = [_RC_MARK.sub("", b) for b in body]
-            return
-        body = [_RC_GPR.sub(r"r\1", b) for b in body]
-        written = {int(n) for b in body for n in _RC_WRITE.findall(b)}
-
-        def stores(regs):
-            return "".join(f"ctx->gpr[{n}] = r{n}; " for n in sorted(regs))
-        reload = "".join(f"r{n} = ctx->gpr[{n}]; " for n in used)
-
-        out, dirty = [], set()
-        for b in body:
-            if b.endswith(":"):
-                # A label can be reached from anywhere in the function, with
-                # anything it wrote still pending.
-                dirty = set(written)
-                out.append(b)
-                continue
-            parts = re.split(r"(/\*@[XOI]\*/)", b)
-            text = []
