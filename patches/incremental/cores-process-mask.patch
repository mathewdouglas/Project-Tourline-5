+/* PS3_CORES_PROCESS_MASK (on; =0 old): the logical CPUs this process may
+ * run on (GetProcessAffinityMask), so the core lists below leave out CPUs a
+ * restricted process cannot use. Pinning a thread outside the process mask
+ * fails, so a restricted process (GT5P_CPU_MASK, or `start /affinity`) used to
+ * leave those threads unpinned while the topology still counted every core.
+ * With the whole machine allowed (the normal case) nothing changes. */
+static DWORD_PTR spurs_process_cpus(void)
+{
+    static DWORD_PTR m = 0;
+    if (!m) {
+        DWORD_PTR p = 0, s = 0;
+        const char* e = getenv("PS3_CORES_PROCESS_MASK");
+        if ((e && e[0] == '0') || !GetProcessAffinityMask(GetCurrentProcess(), &p, &s) || !p) p = ~(DWORD_PTR)0;
+        m = p;
+    }
+    return m;
+}
