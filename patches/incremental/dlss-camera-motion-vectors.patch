+static int mv_inv4(const double* m, double* out)
+{
+    double a[4][8];
+    for (int i = 0; i < 4; i++)
+        for (int j = 0; j < 8; j++) a[i][j] = j < 4 ? m[i * 4 + j] : (j - 4 == i ? 1.0 : 0.0);
+    for (int c = 0; c < 4; c++) {
+        int p = c;
+        for (int r = c + 1; r < 4; r++) if (fabs(a[r][c]) > fabs(a[p][c])) p = r;
+        if (fabs(a[p][c]) < 1e-12) return 0;
+        if (p != c) for (int j = 0; j < 8; j++) { double t = a[c][j]; a[c][j] = a[p][j]; a[p][j] = t; }
+        const double pv = a[c][c];
+        for (int j = 0; j < 8; j++) a[c][j] /= pv;
+        for (int r = 0; r < 4; r++)
+            if (r != c && a[r][c] != 0.0) {
+                const double f = a[r][c];
+                for (int j = 0; j < 8; j++) a[r][j] -= f * a[c][j];
+            }
+    }
+    for (int i = 0; i < 4; i++) for (int j = 0; j < 4; j++) out[i * 4 + j] = a[i][j + 4];
+    return 1;
 }
+static void mv_mul4(const double* a, const double* b, double* out)
+{
+    for (int i = 0; i < 4; i++)
+        for (int j = 0; j < 4; j++) {
+            double t = 0;
+            for (int k = 0; k < 4; k++) t += a[i * 4 + k] * b[k * 4 + j];
+            out[i * 4 + j] = t;
+        }
+}
