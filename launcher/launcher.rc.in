#include <windows.h>
101 ICON "@CMAKE_SOURCE_DIR@/assets/branding/pt5.ico"
1 RT_MANIFEST "@CMAKE_SOURCE_DIR@/launcher/launcher.manifest"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Project Tourline 5 setup and launcher\0"
   VALUE "ProductName", "Project Tourline 5\0"
   VALUE "FileVersion", "@PROJECT_VERSION@\0"
   VALUE "OriginalFilename", "tourline5.exe\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
